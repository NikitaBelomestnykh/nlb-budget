+ [download]=await Promise.all([p.waitForEvent('download'),p.locator('[data-pm="clarity-workspace-backup"]').click()]);await download.saveAs(wholePath);const whole=JSON.parse(fs.readFileSync(wholePath));assert.equal(whole.vendorAgreementData.length,3);
+ for(const [file,workspace] of [[singlePath,false],[wholePath,true]]){const c=await b.newContext({acceptDownloads:true}),q=await c.newPage();let alerts=[];q.on('pageerror',e=>errors.push(e.message));q.on('dialog',async d=>{alerts.push(d.message());await d.accept()});await q.goto(url);await q.locator('[data-action="open-import"]').click();await q.locator('#import-nlb-input').setInputFiles(file);await q.locator('[data-action="import-nlb"]').click();if(workspace){await q.locator('[data-action="confirm-ok"]').click();}await q.waitForFunction(n=>{const x=JSON.parse(localStorage.getItem('no-longer-budget-v9')||'{}');return x.vendors?.some(v=>v.name===n&&v.agreements?.length===2)},userVendor,{timeout:15000});const restored=await state(q),v=restored.vendors.find(v=>v.name===userVendor);assert.deepEqual(await files(q,v),originals);if(workspace){const extra=restored.vendors.find(x=>x.name==='Unattached Test Vendor');assert.deepEqual(await files(q,extra),[['unattached.txt','Independent agreement']]);}else assert(!restored.vendors.some(x=>x.name==='Unattached Test Vendor'));assert(restored.budgets.some(b=>b.title.endsWith('(Imported)')));assert(!alerts.some(x=>/stopped|error/i.test(x)),alerts.join('; '));await c.close();}
