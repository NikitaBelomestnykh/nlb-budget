+ await p.locator('[name="vendorCalendarMonth"]').fill('2026-11');assert((await p.locator('.vd-day').filter({hasText:'Due $1,500.00'}).count())===1);let s=await state(p),vendor=s.vendors.find(v=>v.name===userVendor);assert.deepEqual(await files(p,vendor),originals);const budget=s.budgets.find(b=>b.id===s.activeBudgetId);assert.equal(budget.cashflow.ledger.filter(x=>x.label?.includes('Life rights')).length,0,'scheduling must not post payment');
