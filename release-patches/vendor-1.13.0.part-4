diff --git a/tests/calendar-daily-local.test.cjs b/tests/calendar-daily-local.test.cjs
new file mode 100644
index 0000000..7fd62a5
--- /dev/null
+++ b/tests/calendar-daily-local.test.cjs
@@ -0,0 +1,28 @@
+// Browser test for calendar daily due totals.
+const assert = require('node:assert/strict');
+const {chromium} = require('playwright');
+const path = require('node:path');
+(async () => {
+  const browser = await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});
+  try {
+    const page = await browser.newPage({viewport:{width:1440,height:900}});
+    const errors=[]; page.on('pageerror', e=>errors.push(e.message));
+    await page.goto('file://'+path.resolve(__dirname,'../index.html'));
+    await page.locator('[data-action="pm-open"]').click();
+    await page.locator('[data-pm="tab"][data-id="calendar"]').click();
+    await page.locator('[name="calendarMonth"]').fill('2026-11');
+    const check = async () => page.locator('.pm-calendar .pm-day').evaluateAll(days => days.map(day => {
+      const money = s => { const m=s.match(/([\d,]+\.\d\d)/); return m ? Number(m[1].replaceAll(',','')) : 0; };
+      const planned = Array.from(day.querySelectorAll('.pm-event')).filter(e=>e.textContent.includes('planned payment'));
+      const expected = Math.round(planned.reduce((a,e)=>a+money(e.textContent),0)*100)/100;
+      return {expected, shown:money(day.querySelector('.pm-day-total')?.textContent||''), count:planned.length};
+    }));
+    let rows=await check();assert(rows.some(x=>x.count),'sample contains planned payments');
+    rows.forEach(r=>assert.equal(r.shown,r.expected,'day total must equal displayed planned payments'));
+    await page.locator('[name="includePaid"]').check();rows=await check();rows.forEach(r=>assert.equal(r.shown,r.expected,'history must not add to due totals'));
+    let vendors=await page.locator('[name="filterVendor"] option').evaluateAll(opts=>opts.map(o=>o.value).filter(Boolean));
+    assert(vendors.length,'sample has vendors');
+    for(const vendor of vendors){await page.locator('[name="filterVendor"]').selectOption(vendor);rows=await check();rows.forEach(r=>assert.equal(r.shown,r.expected,'filtered due totals must match visible allocations'));}
+    assert.deepEqual(errors,[]);console.log('PASS local calendar daily totals, history and vendor filters');
+  } finally {await browser.close()}
+})().catch(e=>{console.error(e);process.exitCode=1});
diff --git a/tests/vendor-example-local.test.cjs b/tests/vendor-example-local.test.cjs
new file mode 100644
index 0000000..80f64ad
--- /dev/null
+++ b/tests/vendor-example-local.test.cjs
@@ -0,0 +1,4 @@
+const assert=require('node:assert/strict');const path=require('node:path');const {chromium}=require('playwright');
+(async()=>{const b=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{const p=await b.newPage({viewport:{width:1440,height:900}});const errors=[];p.on('pageerror',e=>errors.push(e.message));await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.evaluate(()=>{const key='no-longer-budget-v9',s=JSON.parse(localStorage.getItem(key)),b=s.budgets[0],a=b.accounts[0],sub=a.subAccounts[0],base=sub.lines[0],line=(id,description,qty,rate)=>({...base,id,description,qty,x:1,rate,fringeIds:[],groupIds:[],raw:{},actual:'',vendorId:undefined});sub.num='2701';sub.name='Location';sub.lines=[line('location-shoot','Filming — 2 days',2,2000),line('location-studio','Studio contribution',1,500)];a.num='2700';a.name='Locations';a.subAccounts=[sub];b.accounts=[a];b.title='Location Example';b.contingencyPercent=0;b.fringes=[];delete b.sampleVersion;b.cashflow={version:1,lineMeta:{},schedules:[],ledger:[],funding:[],documents:[],phases:{},milestones:[],openingCash:0,openingDate:'',invoices:[],returns:[]};s.budgets=[b];s.activeBudgetId=b.id;s.vendors=[];localStorage.setItem(key,JSON.stringify(s));});await p.reload();await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="vendors"]').click();await p.locator('[data-pm="new-vendor"]').click();await p.locator('[name="name"]').last().fill('Location');await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();await p.locator('.vendor-dash-heading').getByText('Location',{exact:true}).waitFor();await p.locator('[data-pm="vendor-link"]').click();await p.locator('[name="vendorLine"]').nth(0).check();await p.locator('[name="vendorLine"]').nth(1).check();await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();assert.match(await p.locator('.vd-stats').innerText(),/\$4,500\.00/);
+for(const [id,amount] of [['location-shoot','4000'],['location-studio','500']]){await p.locator(`[data-pm="vendor-plan"][data-id="${id}"]`).click();await p.locator('[name="amount"]').fill(amount);await p.locator('[name="due"]').fill('2026-12-03');await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();}
+await p.locator('[name="vendorCalendarMonth"]').fill('2026-12');assert.equal(await p.locator('.vd-day').filter({hasText:'Due $4,500.00'}).count(),1);await p.locator('[data-pm="record"]').first().click();await p.locator('[name="amount"]').fill('1000');await p.locator('[name="date"]').fill('2026-12-03');await p.locator('[name="skipReceipt"]').check();await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();const text=await p.locator('.vd-stats').innerText();assert.match(text,/Expected final\s+\$4,500\.00/);assert.match(text,/Net paid\s+\$1,000\.00/);assert.match(text,/Scheduled, unpaid\s+\$3,500\.00/);assert.equal(await p.locator('.vd-day').filter({hasText:'Due $3,500.00'}).count(),1);const state=await p.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9')));const cash=state.budgets[0].cashflow;assert.equal(cash.ledger.length,1);assert.equal(cash.ledger[0].amount,1000);assert.equal(cash.schedules.length,2);assert.deepEqual(errors,[]);console.log('PASS $4,500 location example, payment dates, partial paid and totals');}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
