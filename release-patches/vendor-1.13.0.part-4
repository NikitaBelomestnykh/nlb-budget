+const os=require('node:os');const tmp=fsTemp();function fsTemp(){return require('node:fs').mkdtempSync(require('node:path').join(os.tmpdir(),'nlb-vendor-'))}const singlePath=require('node:path').join(tmp,'vendor-test.nlb'),wholePath=require('node:path').join(tmp,'vendor-workspace.json'),brokenPath=require('node:path').join(tmp,'vendor-broken.nlb');
+const assert=require('node:assert/strict');const fs=require('node:fs');const path=require('node:path');const {chromium}=require('playwright');
+const url='file://'+path.resolve(__dirname,'../index.html');const userVendor='Studio Test Vendor';const originals=[['signed-a.txt','Signed agreement A'],['signed-b.txt','Signed agreement B']];
+async function open(p){await p.goto(url);await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="vendors"]').click();}
+async function state(p){return p.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9')))}
+async function files(p,v){return p.evaluate(async v=>{const db=await new Promise((r,j)=>{const q=indexedDB.open('nlb-document-store-v1',1);q.onsuccess=()=>r(q.result);q.onerror=()=>j(q.error)});return await Promise.all(v.agreements.map(a=>new Promise((r,j)=>{const q=db.transaction('files').objectStore('files').get(a.key);q.onsuccess=async()=>r([a.originalName,await q.result.text()]);q.onerror=()=>j(q.error)})))},v)}
+(async()=>{const b=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{
+ const ctx=await b.newContext({viewport:{width:1440,height:900},acceptDownloads:true}),p=await ctx.newPage();const errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('dialog',d=>d.accept());await open(p);
