+ await p.locator('[data-pm="vendors-overview"]').click();await p.locator('[data-pm="new-vendor"]').click();await p.locator('input[name="name"]').last().fill('Unattached Test Vendor');await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();await p.locator('#vd-upload').setInputFiles({name:'unattached.txt',mimeType:'text/plain',buffer:Buffer.from('Independent agreement')});await p.waitForFunction(()=>document.querySelectorAll('.vd-agreements article').length===1);await p.locator('[data-pm="vendors-overview"]').click();await p.locator('.vd-vendor-card').filter({hasText:userVendor}).locator('[data-pm="vendor-dashboard"]').click();
+ await p.locator('[data-pm="vendor-link"]').click();await p.locator('[name="vendorLine"]').nth(0).check();await p.locator('[name="vendorLine"]').nth(1).check();await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();assert.equal(await p.locator('.vd-line').count(),2);
