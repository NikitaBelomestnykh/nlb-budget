   async function pmDocumentsZip(ids){const zip=new JSZip(),docs=ids?pmCF().documents.filter(d=>ids.includes(d.id)):pmExportDocs();if(!docs.length)throw Error('Select at least one document for the ZIP.');const index=[];for(const [i,d]of docs.entries()){const filename=String(i+1).padStart(3,'0')+'_'+pmSafeFile(d.internalName)+'_'+pmSafeFile(d.originalName);zip.file(filename,await pmBlob(d));index.push({file:filename,original:d.originalName,internalName:d.internalName,tags:d.tags,assignments:d.links.map(pmDocLinkLabel),status:pmDocStatus(d),exportPrivacy:d.internal?'Excluded from