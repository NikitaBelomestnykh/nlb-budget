 .journey-reminders{border:1px solid var(--border);border-radius:10px;padding:16px;margin-bottom:24px}.journey-reminders h3{margin:0}.journey-reminder{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-top:1px solid var(--border)}.journey-reminder small{display:block;color:var(--text-2);margin-top:4px}
