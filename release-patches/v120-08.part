tyCloseoutHTML(){const b=active(),rows=PC.lines(b),ss=rows.map(r=>LC.status(b,r.line.id,pmCalc)),unconfirmed=rows.filter(r=>!PC.meta(b,r.line.id)?.confirmed&&!PC.meta(b,r.line.id)?.closed&&!PC.meta(b,r.line.id)?.lifecycleClosed).length,missing=LC.ensure(b).ledger.filter(e=>e.kind==='payment'&&LC.missingReceipts(b,e.allocations[0]?.lineId).some(x=>x.id===e.id)).length,legacy=rows.filter(r=>{const m=PC.meta(b,r.line.id)||{};return(m.openingBase||m.openingFringe)&&!m.openingReviewed;}).length,uns=PC.sum(PC.unscheduled(b,pmCalc),r=>r.base+r.fringe);return `<section class="lc-section clarity-closeout"><h3>Production closeout review</h3><p class="pm-note">Whole-budget checks, independent of the filters above. Review these figures against your records; they do not reconcile your bank.</p><dl><div><dt>Still owed</dt><dd>${pmAmount(PC.sum(ss,s=>s.owed))}</dd></div><div><dt>Expected refunds</dt><dd>${pmAmount(PC.sum(ss,s=>s.returns))}</dd></div><div><dt>Not scheduled yet</dt><dd>${pmAmount(uns)}</dd></div><div><dt>Payments missing receipts</dt><dd>${missing}</dd></div><div><dt>Expected costs not confirmed</dt><dd>${unconfirmed}</dd></div><div><dt>Legacy Actuals needing review</dt><dd>${legacy}</dd></div></dl><p class="pm-note">Then verify funding, receipts and refunds, review sensitive files, download the binder/reports and keep an external backup. Not scheduled yet measures unallocated/undated outgoing requirements; undated refunds/funding need separate review.</p><button type="button" class="btn btn-ghost" data-action="clarity-closeout-help">Open closeout checklist</button></section>`;}
