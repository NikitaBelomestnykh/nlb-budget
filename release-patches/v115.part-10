ame:'unattached.txt',mimeType:'text/plain',buffer:Buffer.from('Independent agreement')});await p.waitForFunction(()=>document.querySelectorAll('.vd-agreements article').length===1);await p.locator('[data-pm="vendors-overview"]').click();await p.locator('.vd-vendor-card').filter({hasText:userVendor}).locator('[data-pm="vendor-dashboard"]').click();
