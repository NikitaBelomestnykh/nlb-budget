+  function pmInitCalendar(){const stream=document.querySelector('#pm-layer .pm-calendar-stream');if(!stream)return;const activeMonth=stream.querySelector(`[data-month="${pm.month}"]`);if(activeMonth)stream.scrollTop=activeMonth.offsetTop-stream.firstElementChild.offsetTop;stream.onscroll=()=>{if(stream.dataset.adjusting)return;stream.dataset.adjusting='1';let panels=stream.querySelectorAll('.pm-month-panel');if(stream.scrollTop<120){const previous=pmShiftMonth(panels[0].dataset.month,-1);if(previous){const old=stream.scrollHeight;stream.insertAdjacentHTML('afterbegin',pmMonthHTML(previous));stream.scrollTop+=stream.scrollHeight-old;panels=stream.querySelectorAll('.pm-month-panel');if(panels.length>18)panels[panels.length-1].remove();}}else if(stream.scrollHeight-stream.scrollTop-stream.clientHeight<200){const next=pmShiftMonth(panels[panels.length-1].dataset.month,1);if(next){stream.insertAdjacentHTML('beforeend',pmMonthHTML(next));panels=stream.querySelectorAll('.pm-month-panel');if(panels.length>18){const old=stream.scrollHeight;panels[0].remove();stream.scrollTop-=old-stream.scrollHeight;}}}panels=stream.querySelectorAll('.pm-month-panel');const top=stream.getBoundingClientRect().top;let current=panels[0];for(const el of panels){if(el.getBoundingClientRect().top<=top+35)current=el;else break;}if(current){pm.month=current.dataset.month;const input=document.querySelector('#pm-layer input[name="calendarMonth"]');if(input)input.value=pm.month;}delete stream.dataset.adjusting;};}
