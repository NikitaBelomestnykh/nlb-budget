   function pmDocsHTML(){const row=d=>{const status=pmDocStatus(d),values={name:d.internalName+' '+d.originalName,tags:(d.tags||[]).join(', '),assignments:d.links.map(pmDocLinkLabel).join('; '),status};return `<tr data-pm-library-row="docs" data-id="${esc(d.id)}" data-values="${esc(JSON.stringify(values))}"><td>${esc(d.internalName)}<br><small>${esc(d.originalName)} · ${(d.size/1024).toFixed(0)} KB</small></td><td>${esc((d.tags||[]).join(', '))}</td><td>${d.links.map(l=>esc(pmDocLinkLabel(l))).join('<br>')||'Unassigned'}</td><td>${pmStatus(status,'docs')}</td><td class="pm-library-actions">${pmBtn('preview-doc','Preview',d.id)}${pmBtn('download-doc','Download',d.id)}${pmBtn('edit-doc','Edit details',d.id)}${pmBtn('archive-doc',d.archived?'Unarchive':'Archive',d.id)}${pmBtn('delete-doc','Remove',d.id)}</td></tr>`;};return `<div class="pm-toolbar pm-doc-toolbar"><input type="file" id="pm-upload" multiple hidden accept="application/pdf,image/*,.heic,.doc,.docx,.xls,.xlsx,.csv,.txt">${pmBtn('choose-upload','Upload Documents…','','pm-primary')}${pmInput('docSearch','Search documents',pm.docQuery||'','search','placeholder="Name, filename, tag or assignment"')}${pmBtn('clear-doc-filters','Clear filters')}${pmBtn('documents-zip','Download ZIP…')}</div><p class="pm-note">Upload first, assign later. Uploading never posts a cost. Archive keeps originals and assignments, and can be undone with Unarchive. Files stay on this computer; there is no online sharing. Export privacy in document details controls default binder inclusion, not access permissions. ZIP lets you explicitly select any documents. Full .nlb backups include all originals.</p><p class="pm-note" data-pm-library-count="docs" role="status"></p><div class="pm-scroll"><table class="pm-table pm-library-table pm-document-table"><thead><tr>${pmColumnFilters('docs',[['name','Internal / original name'],['tags','Tags'],['assignments','Assignments'],['status','Status',['Assigned','Unassigned','Archived']]])}<th scope="col">Actions</th></tr></thead><tbody>${pmLibraryRows('docs',pmCF().documents,row)}</tbody></table></div>`;}
