+ return`<div class="pt-overview"><div class="pm-card-heading"><div><h3>Production timeline</h3><p>Production phases and custom milestones at a glance</p></div></div>${pmVisualTimeline(cf)}</div><div class="pm-card"><div class="pm-card-heading"><h3>Production dates & opening cash</h3>${editing?'':pmBtn('edit-timeline','Edit timeline')}</div>${content}</div><div class="pm-toolbar pm-heading-toolbar"><h3>Custom milestones</h3>${pmBtn('new-milestone','Add milestone')}</div><div class="pm-scroll"><table class="pm-table"><tbody>${cf.milestones.map(m=>`<tr><td>${esc(m.name)}</td><td>${esc(m.date||'No date')}</td><td>${pmBtn('edit-milestone','Edit',m.id)}</td></tr>`).join('')||'<tr><td>No custom milestones.</td></tr>'}</tbody></table></div><div class="pm-toolbar pm-heading-toolbar"><h3>Incoming production funding</h3>${pmBtn('new-funding','Add funding','','pm-primary')}</div><div class="pm-scroll"><table class="pm-table"><thead><tr><th>Source</th><th>Expected</th><th>Expected date</th><th>Received</th><th>Received date</th><th></th></tr></thead><tbody>${cf.funding.map(f=>`<tr><td>${esc(f.source)}</td><td>${pmAmount(f.expected)}</td><td>${esc(f.expectedDate||'Not scheduled yet')}</td><td>${pmAmount(f.received)}</td><td>${esc(f.receivedDate||'—')}</td><td>${pmBtn('edit-funding','Edit',f.id)}</td></tr>`).join('')||'<tr><td colspan="6">Add a separate entry for each funding tranche.</td></tr>'}</tbody></table></div>`;
   }
   function pmEvents(){return PC.events(active(),pmCalc).filter(e=>!e.allocations||e.allocations.some(a=>pmMatch(a.lineId))).map(e=>{if(!e.allocations)return e;const v=PC.sum(e.allocations.filter(a=>pmMatch(a.lineId)),a=>a.base+a.fringe);const sign=['refund','expected refund'].includes(e.type)?1:-1;return{...e,allocations:e.allocations.filter(a=>pmMatch(a.lineId)),amount:sign*Math.abs(v)};});}
   function pmCashHTML(){const cf=pmCF(),reserve=PC.reserve(active(),pmCalc),events=PC.events(active(),pmCalc),dated=events.filter(e=>e.date&&(!cf.openingDate||e.date>=cf.openingDate));let balance=Number(cf.openingCash)||0;let rows=dated.map(e=>{balance=PC.money(balance+e.amount);return`<tr><td>${esc(e.date)}</td><td>${esc(e.type)}</td><td>${esc(e.label)}</td><td class="pm-money">${e.amount>0?pmAmount(e.amount):'—'}</td><td class="pm-money">${e.amount<0?pmAmount(-e.amount):'—'}</td><td class="pm-money ${balance<0?'variance-over':''}">${pmAmount(balance)}</td></tr>`;}).join('');const uns=PC.sum(PC.unscheduled(active(),pmCalc),r=>r.base+r.fringe),undated=PC.sum(events.filter(e=>!e.date&&e.amount<0),e=>-e.amount),undatedFunds=PC.sum(events.filter(e=>!e.date&&e.amount>0),e=>e.amount);return pmStats()+`<p class="pm-note">Budget-wide forecast. Opening ${pmAmount(cf.openingCash)} as of ${esc(cf.openingDate||'the start of all recorded movements')}. Received funds and future expected funds are labeled separately; expected funding is not money already in the bank.</p><div class="pm-alert">Not scheduled yet: ${pmAmount(uns+undated)} outgoing (${pmAmount(uns)} unallocated + ${pmAmount(undated)} installments without dates). Undated incoming funds: ${pmAmount(undatedFunds)}. Reserve held: ${pmAmount(reserve.remaining)}. These are outside the dated balance below; no reserve spending date is invented.</div><div class="pm-scroll"><table class="pm-table"><thead><tr><th>Date</th><th>Type</th><th>Item</th><th>Incoming</th><th>Outgoing</th><th>Projected cash</th></tr></thead><tbody>${rows||'<tr><td colspan="6">No dated cash movements.</td></tr>'}</tbody></table></div><p class="pm-note">Projected closing cash ${pmAmount(balance)}; after reserving contingency ${pmAmount(balance-reserve.remaining)}. Unscheduled costs are still additional cash requirements. Reserve allocations identify costs already funded from contingency, reducing the remaining reserve without adding another payment.</p>`;}
-  function pmCalendarHTML(){let [year,month]=pm.month.split('-').map(Number);if(!year||!month){pm.month=pmToday().slice(0,7);[year,month]=pm.month.split('-').map(Number);}const first=new Date(Date.UTC(year,month-1,1)),days=new Date(Date.UTC(year,month,0)).getUTCDate();let cells=Array.from({length:first.getUTCDay()},()=>'<div class="pm-day"></div>');const ev=pmEvents().filter(e=>pm.paid||['planned payment','expected funding','expected refund'].includes(e.type));for(let day=1;day<=days;day++){const date=`${year}-${String(month).padStart(2,'0')}-${String(day).padStart(2,'0')}`;const todayEvents=ev.filter(e=>e.date===date),due=PC.sum(todayEvents.filter(e=>e.type==='planned payment'),e=>Math.abs(e.amount));cells.push(`<div class="pm-day"><strong>${day}</strong>${due>0.009?`<div class="pm-day-total">Due ${pmAmount(due)}</div>`:''}${todayEvents.map(e=>`<span class="pm-event">${esc(e.label)}<br>${e.amount<0?'Out ':'In '}${pmAmount(Math.abs(e.amount))}<br><small>${esc(e.type)}</small></span>`).join('')}</div>`);}return pmFilters()+`<div class="pm-toolbar"><label>Month <input type="month" name="calendarMonth" value="${esc(pm.month)}"></label><label><input type="checkbox" name="includePaid"${pm.paid?' checked':''} style="width:16px;min-height:16px"> Include paid/received history</label>${pmBtn('calendar-pdf','Download month PDF')}${pmBtn('calendar-ics','Download month .ics')}${pmBtn('tab','Custom date range…','downloads')}</div><p class="pm-note">Calendar snapshots are not synchronized. Create a dedicated calendar in Apple/Google Calendar and import this file; delete that old dedicated calendar before importing a newer snapshot into another new calendar. Undated items cannot appear as dated events.</p><div class="pm-calendar">${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div class="pm-day" style="min-height:0"><strong>${d}</strong></div>`).join('')}${cells.join('')}</div>`;}
+  function pmShiftMonth(value,delta){const [y,m]=String(value).split('-').map(Number),n=y*12+m-1+delta;if(!y||!m||n<12||n>119999)return '';return String(Math.floor(n/12)).padStart(4,'0')+'-'+String(n%12+1).padStart(2,'0');}
+  function pmMonthHTML(value){const [year,month]=value.split('-').map(Number),first=new Date(0);first.setUTCHours(0,0,0,0);first.setUTCFullYear(year,month-1,1);const next=new Date(first);next.setUTCMonth(next.getUTCMonth()+1);next.setUTCDate(0);const days=next.getUTCDate(),events=pmEvents().filter(e=>pm.paid||['planned payment','expected funding','expected refund'].includes(e.type));let cells=Array.from({length:first.getUTCDay()},()=>'<div class="pm-day pm-day-empty"></div>');for(let day=1;day<=days;day++){const date=value+'-'+String(day).padStart(2,'0'),today=events.filter(e=>e.date===date),due=PC.sum(today.filter(e=>e.type==='planned payment'),e=>Math.abs(e.amount));cells.push(`<div class="pm-day"><strong>${day}</strong>${due>0.009?`<div class="pm-day-total">Due ${pmAmount(due)}</div>`:''}${today.map(e=>`<span class="pm-event">${esc(e.label)}<br>${e.amount<0?'Out ':'In '}${pmAmount(Math.abs(e.amount))}<br><small>${esc(e.type)}</small></span>`).join('')}</div>`);}while(cells.length%7)cells.push('<div class="pm-day pm-day-empty"></div>');return `<section class="pm-month-panel" data-month="${esc(value)}"><h3>${esc(first.toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'}))}</h3><div class="pm-calendar">${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=>`<div class="pm-weekday"><strong>${d}</strong></div>`).join('')}${cells.join('')}</div></section>`;}
+  function pmCalendarHTML(){if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(pm.month)||pm.month.startsWith('0000'))pm.month=pmToday().slice(0,7);const months=[pmShiftMonth(pm.month,-1),pm.month,pmShiftMonth(pm.month,1)].filter(Boolean);return pmFilters()+`<div class="pm-toolbar pm-calendar-controls"><label>Month <input type="month" name="calendarMonth" value="${esc(pm.month)}"></label><div class="pm-month-buttons">${pmBtn('calendar-prev','← Previous month')}${pmBtn('calendar-today','Today')}${pmBtn('calendar-next','Next month →')}</div><label><input type="checkbox" name="includePaid"${pm.paid?' checked':''} style="width:16px;min-height:16px"> Include paid/received history</label>${pmBtn('calendar-pdf','Download month PDF')}${pmBtn('calendar-ics','Download month .ics')}${pmBtn('tab','Custom date range…','downloads')}</div><p class="pm-note">Scroll up or down for more months. Downloads use the month shown in the month selector. Calendar snapshots do not sync; import each i