+ return`<div class="lc-page">${journeyDueHTML()}<h3>Payments by budget line</h3><p class="pm-note">Open a line to confirm its cost, enter invoices, record payments and collect receipts. Actuals are paid amounts minus received refunds—not unpaid invoices.</p>${lcStats(rs)}${lcWarnings(rs)}${pmFilters()}${pmSelect('lifecycleStage','Lifecycle stage',['Estimated','Confirmed','Invoiced','Partially paid','Paid','Closed'].map(id=>({id,name:id})),pm.stage||'','All stages')}${lcLinesTable(rs.filter(r=>!pm.stage||LC.status(active(),r.line.id,pmCalc).stage===pm.stage))}<details class="lc-section"><summary>Shared parent setup</summary><p class="pm-note">Set one vendor/payroll default or allocate one invoice across an account/sub-account.</p><div class="lc-parent-links">${active().accounts.map(a=>`<div>${pmBtn('lc-target','Account '+a.num+' '+esc(a.name),'account:'+a.id)}${a.subAccounts.map(s=>pmBtn('lc-target',s.num+' '+esc(s.name),'sub:'+s.id)).join('')}</div>`).join('')}</div></details></div>`;};
+  function journeyLineStatus(id){const cf=pmCF(),plans=cf.schedules.filter(p=>!p.cancelled&&((p.allocations||[]).some(a=>a.lineId===id)||p.mode!=='fixed'&&p.lineId===id)),paid=PC.net(active(),id,'base')+PC.net(active(),id,'fringe'),life=LC.status(active(),id,pmCalc),unpaid=plans.filter(p=>PC.parts(active(),p,pmCalc).some(a=>a.lineId===id&&a.base+a.fringe>.009)),undated=unpaid.some(p=>!PC.validDate(PC.date(active(),p))),hasPayment=cf.ledger.some(e=>e.kind==='payment'&&(e.allocations||[]).some(a=>a.lineId===id))||paid>.009;if((life.stage==='Paid'||life.stage==='Closed')&&hasPayment&&!unpaid.length)return {name:'Paid',color:'green'};if(life.stage==='Partially paid'||paid>.009&&(unpaid.length||life.owed>.009))return {name:'Partially paid',color:'blue'};if(!unpaid.length||undated)return {name:'No payment date',color:'red'};return unpaid.every(p=>p.journeyStatus==='confirmed')?{name:'Confirmed',color:'blue'}:{name:'Expected',color:'yellow'};}
