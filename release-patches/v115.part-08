+const assert=require('node:assert/strict'),path=require('node:path'),fs=require('node:fs'),os=require('node:os'),{execFileSync}=require('node:child_process'),{chromium}=require('playwright');
+(async()=>{const b=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']}),tmp=fs.mkdtempSync(path.join(os.tmpdir(),'nlb-cal-'));try{const p=await b.newPage({acceptDownloads:true}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.clock.install({time:new Date('2026-11-24T12:00:00Z')});await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="calendar"]').click();await p.locator('[name="mainFrom"]').fill('2026-11-03');await p.locator('[name="mainTo"]').fill('2026-11-03');for(const [kind,ext] of [['csv','csv'],['ics','ics'],['pdf','pdf']]){const [d]=await Promise.all([p.waitForEvent('download'),p.locator('[data-pm="calendar-'+kind+'"]').click()]);assert.match(d.suggestedFilename(),/2026-11-03 to 2026-11-03/);const dest=path.join(tmp,'out.'+ext);await d.saveAs(dest);let content;if(ext==='pdf'){assert.equal(fs.readFileSync(dest).subarray(0,4).toString(),'%PDF');try{content=execFileSync('pdftotext',[dest,'-']).toString();}catch(e){if(e.code!=='ENOENT')throw e;}}else content=fs.readFileSync(dest,'utf8');if(content){assert.match(content,/Camera balance at wrap/);assert(!content.includes('Crew remaining fringes'),'outside-range event excluded');}if(ext==='ics')assert(content.includes('DTSTART;VALUE=DATE:20261103'));if(ext==='csv')assert(content.includes('18900'));}assert.deepEqual(errors,[]);console.log('PASS same inclusive date range across calendar PDF, CSV and ICS');}finally{await b.close();fs.rmSync(tmp,{recursive:true,force:true})}})().catch(e=>{console.error(e);process.exitCode=1});
