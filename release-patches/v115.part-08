+const assert=require('node:assert/strict'),path=require('node:path'),fs=require('fs'),os=require('os');const {chromium}=require('playwright');
+(async()=>{const b=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{const p=await b.newPage({acceptDownloads:true,viewport:{width:1440,height:900}}),errors=[];p.on('pageerror',e=>errors.push(e.message));p.on('dialog',d=>{errors.push(d.message());d.dismiss()});await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="timeline"]').click();assert(await p.locator('.pt-row').count()>=3);assert.equal(await p.locator('text=Production dates & opening cash').count(),0);await p.locator('[data-pm="edit-timeline"]').click();assert(await p.locator('input[name="openingDate"]').count());await p.locator('[data-pm="cancel-timeline"]').click();await p.locator('[name="newMilestoneType"]').selectOption('funding');await p.locator('[data-pm="add-typed-milestone"]').click();assert.match(await p.locator('.pm-editor h3').innerText(),/funding/i);await p.locator('[data-pm="cancel-editor"]').first().click();await p.locator('[data-pm="tab"][data-id="calendar"]').click();assert.equal(await p.locator('[name="calendarMonth"]').count(),0);const range=p.locator('[name="mainRange"]');for(const k of ['week','month','year','max']){await range.selectOption(k);assert.equal(await range.inputValue(),k)}await p.locator('[name="mainFrom"]').fill('2026-11-01');await p.locator('[name="mainTo"]').fill('2026-11-30');assert.equal(await range.inputValue(),'custom');assert.equal(await p.locator('[name="mainFrom"]').inputValue(),'2026-11-01');assert.equal(await p.locator('[name="mainTo"]').inputValue(),'2026-11-30');const [dl]=await Promise.all([p.waitForEvent('download'),p.locator('[data-pm="calendar-csv"]').click()]);assert.match(dl.suggestedFilename(),/2026-11-01 to 2026-11-30\.csv/);let chunks=[];for await(const c of await dl.createReadStream())chunks.push(c);assert.match(Buffer.concat(chunks).toString(),/Date,Direction,Account,Amount,Description,Status/);await p.locator('[data-pm="calendar-today"]').click();assert.equal(await range.inputValue(),'month');assert.equal(await p.locator('.pm-day-today').count(),1);await p.locator('[data-pm="tab"][data-id="vendors"]').click();await p.locator('.vd-vendor-card [data-pm="vendor-dashboard"]').first().click();assert(await p.locator('.vd-calendar-stream').count());assert(await p.locator('[data-pm="vendor-calendar-today"]').count());await p.locator('[data-pm="vendor-calendar-today"]').click();assert(await p.locator('.vd-day-today').count());assert.deepEqual(errors,[]);console.log('PASS range controls, CSV, Today, timeline and vendor calendar');}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
diff --git a/tests/contact-csv-v115.test.cjs b/tests/contact-csv-v115.test.cjs
new file mode 100644
