@@ -0,0 +1,2 @@
+const assert=require('node:assert/strict'),path=require('node:path');const {chromium}=require('playwright');
+(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{const page=await browser.newPage({acceptDownloads:true});let errors=[];page.on('pageerror',e=>errors.push(e.message));page.on('dialog',d=>{errors.push('dialog:'+d.message());d.dismiss()});await page.goto('file://'+path.resolve(__dirname,'../index.html'));await page.locator('[data-action="pm-open"]').click();await page.locator('[data-pm="tab"][data-id="crew"]').click();const [chooser]=await Promise.all([page.waitForEvent('filechooser'),page.locator('[data-pm="contact-csv-choose"]').click()]);await chooser.setFiles({name:'crew.csv',mimeType:'text/csv',buffer:Buffer.from('Person,Email,Allergies\n"Smith, Joan",joan@example.com,Peanuts\nAlex,alex@example.com,None\n')});await page.locator('[name="map:name"]').selectOption('1');await page.locator('form[data-pm-form="editor"] button[type=submit]').click();await page.locator('.vd-vendor-card').filter({hasText:'Smith, Joan'}).waitFor();const state=await page.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9')));const joan=state.vendors.find(x=>x.name==='Smith, Joan');assert.deepEqual(joan.roles,['crew']);assert.equal(joan.email,'joan@example.com');assert.equal(joan.allergies,'Peanuts');await page.locator('.vd-vendor-card').filter({hasText:'Smith, Joan'}).locator('[data-pm="edit-vendor"]').click();assert.equal(await page.locator('[name="allergies"]').inputValue(),'Peanuts');assert.equal(await page.locator('[name="contactRole"]:checked').inputValue(),'crew');assert.deepEqual(errors,[]);console.log('PASS CSV mapping, quoted fields, crew category and allergies');}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
