+await plans();await p.locator(`[data-pm="edit-schedule"][data-id="${plan.id}"]`).click();await p.locator('[name="paymentVendorId"]').selectOption('crew1');await p.locator('[name="due"]').fill('2026-11-24');await save();c=await cash();assert.equal(c.schedules.length,1);assert.equal(c.schedules[0].id,plan.id);assert.equal(c.schedules[0].payeeId,'crew1');assert.equal(c.ledger.length,0);assert.match(await p.locator('.lc-page-heading').innerText(),/Expected/);
+await plans();await p.locator(`[data-pm="edit-schedule"][data-id="${plan.id}"]`).click();await p.locator('[value="confirmed"][name="journeyStatus"]').check();await p.locator('[name="confirmedDue"]').fill('2026-11-24');await save();c=await cash();assert.equal(c.schedules[0].expectedDue,'2026-11-24');assert.equal(c.schedules[0].confirmedDue,'2026-11-24');assert.equal(c.ledger.length,0);assert.match(await p.locator('.lc-page-heading').innerText(),/Confirmed/);await back();assert.match(await p.locator('.journey-reminder').innerText(),/Filming/);assert.match(await p.locator('tr').filter({hasText:'Filming'}).innerText(),/Confirmed/);
+// A final actual amount above forecast is posted only after explicit paid confirmation.
+await p.locator(`.journey-reminder [data-pm="record"][data-id="${plan.id}"]`).click();await p.locator('[name="amount"]').fill('4200');await p.locator('[name="skipReceipt"]').check();await save();c=await cash();assert.equal(c.ledger.length,1);assert.equal(c.ledger[0].amount,4200);assert.equal(c.schedules[0].total,4200);assert.equal(c.lineMeta.shoot.expectedBase,4200);assert.equal(await p.locator('.journey-reminder').count(),0);assert.match(await p.locator('tr').filter({hasText:'Filming'}).innerText(),/Paid/);
+// Two independent split schedules, paid one at a lower actual amount: preserve the second and report partial.
+await open('split');for(const [amount,date] of [['500','2026-11-24'],['500','2026-11-25']]){await p.locator('[data-pm="line-plan"]').click();await p.locator('[name="amount"]').fill(amount);await p.locator('[name="due"]').fill(date);await p.locator('[name="paymentVendorId"]').selectOption('crew1');await p.locator('[name="splitPayment"]').check();await save();}c=await cash();let sp=c.schedules.filter(x=>x.lineId==='split');assert.equal(sp.length,2);await plans();await p.locator(`[data-pm="record"][data-id="${sp[0].id}"]`).click();await p.locator('[name="amount"]').fill('480');await p.locator('[name="skipReceipt"]').check();await save();c=await cash();assert.equal(c.schedules.find(x=>x.id===sp[0].id).total,480);assert.equal(c.schedules.find(x=>x.id===sp[1].id).total,500);assert.equal(c.ledger.find(x=>x.scheduleId===sp[0].id).amount,480);assert.match(await p.locator('.lc-page-heading').innerText(),/Partially paid/);await back();
+// Timeline contains only production and milestones, while calendar still shows upcoming split.
+await p.locator('[data-pm="tab"][data-id="calendar"]').click();assert.equal(await p.locator('.pt-line-row').count(),0);assert.equal(await p.locator('[name="newMilestoneType"]').count(),0);await p.locator('.pt-add-menu summary').click();assert.equal(await p.locator('[data-pm="new-milestone"]').count(),1);assert.equal(await p.locator('[data-pm="new-funding"]').count(),1);assert.match(await p.locator('.pm-calendar-stream').innerText(),/Split crew/);
+await p.locator('[data-pm="close"]').click();assert.notEqual(await p.evaluate(()=>document.body.style.overflow),'hidden');assert.equal(await p.evaluate(()=>document.querySelector('#confirm-modal').inert),false);assert.deepEqual(errors,[]);console.log('PASS journey statuses, expected/confirmed dates, forecast override, explicit payment, changed actual and split history');
+}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
