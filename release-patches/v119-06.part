s.budgets=[b];s.activeBudgetId=b.id;s.vendors=[{id:'crew1',name:'Test Crew',roles:['crew'],archived:false}];localStorage.setItem(k,JSON.stringify(s));});await p.reload();await p.locator('[data-action="pm-open"]').click();
+const st=()=>p.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9'))), cash=async()=> (await st()).budgets[0].cashflow;const open=async id=>p.locator(`[data-pm="line"][data-id="${id}"]`).first().click(),back=async()=>p.locator('[data-pm="lc-back"]').click(),save=async()=>p.locator('form[data-pm-form="editor"] button[type="submit"]').click(),plans=async()=>{const d=p.locator('details.lc-section').filter({has:p.locator('summary').filter({hasText:'Payment plans'})});if(!await d.getAttribute('open'))await d.locator('summary').click()};
+assert.equal(await p.evaluate(()=>document.body.style.overflow),'hidden');assert(await p.evaluate(()=>[...document.body.children].filter(x=>!['pm-layer','confirm-backdrop','confirm-modal','prompt-backdrop','prompt-modal'].includes(x.id)).every(x=>x.inert)));assert.equal(await p.locator('.space-crumbs li').count(),1);assert.equal((await p.locator('.space-crumbs').innerText()).trim(),'Payments');assert.match(await p.locator('tr').filter({hasText:'Unplanned'}).innerText(),/No payment date/);
+// Save an undated expected forecast and then attach a recipient and date without creating a second plan.
