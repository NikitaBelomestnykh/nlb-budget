 /* Timeline calendar axis and payment editor */
 .pt-axis{height:50px;margin-bottom:4px}.pt-months,.pt-days{position:absolute;left:0;right:0}.pt-months{top:0;height:23px;border-bottom:1px solid var(--border)}.pt-days{top:23px;height:25px}.pt-month-label{position:absolute;top:0;white-space:nowrap;overflow:hidden;text-overflow:clip;font-weight:700;color:var(--text);font-size:11px}.pt-day-tick{position:absolute;top:4px;transform:translateX(-50%);font-size:10px}.pt-week-line{position:absolute;top:0;bottom:0;border-left:2px solid var(--text-2);opacity:.55;pointer-events:none}.pt-days .pt-week-line{bottom:auto;height:6px}.pt-track .pt-week-line{z-index:0}.pt-bar,.pt-dot{z-index:1}
