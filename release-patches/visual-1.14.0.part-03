   function clarityValidateWorkspace(payload){if(payload.workspaceBackupFormat!=='nlb-workspace-1'||!Array.isArray(payload.budgets)||!Array.isArray(payload.vendors)||!Array.isArray(payload.folders))throw Error('Invalid workspace backup.');const unique=(xs,label)=>{if(xs.some(x=>!x||typeof x.id!=='string'||!x.id)||new Set(xs.map(x=>x.id)).size!==xs.length)throw Error('Invalid or duplicate '+label+'.');};unique(payload.budgets,'budget identifiers');unique(payload.vendors,'vendor identifiers');unique(payload.folders,'folder identifiers');if(payload.vendors.some(v=>typeof v.name!=='string'||!v.name.trim())||payload.folders.some(f=>typeof f.name!=='string'||!f.name.trim()))throw Error('Invalid contact or folder names.');if(payload.activeBudgetId&&!payload.budgets.some(b=>b.id===payload.activeBudgetId))throw Error('Active budget is missing.');const originals=vdValidateAgreementData(payload.vendors,payload.vendorAgreementData);for(const b of payload.budgets){if(!Array.isArray(b.accounts)||typeof b.title!=='string'||b.folderId&&!payload.folders.some(f=>f.id===b.folderId))throw Error('Invalid budget or folder reference.');b.vendorRefs=payload.vendors;pmValidateBackup(b);if(!Array.isArray(b.attachmentData))throw Error('Original document list is missing.');const docs=b.cashflow?.documents||[];if(new Set(b.attachmentData.map(a=>a.documentId)).size!==b.attachmentData.length||b.attachmentData.length!==docs.length)throw Error('Original document list does not match this budget.');for(const d of docs){const a=b.attachmentData.find(a=>a.documentId===d.id);if(!a?.base64)throw Error('Missing original: '+d.originalName);const blob=pmDecode(a.base64,d.type);if(d.size!=null&&d.size!==blob.size)throw Error('Document bytes do not match '+d.originalName);originals.push({doc:d,blob});}}return originals;}
