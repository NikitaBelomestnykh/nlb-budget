+  function pmRenderBody(){const layer=document.getElementById('pm-layer');if(!layer||layer.hidden||!active())return;const body=layer.querySelector('.pm-body'),scroll=body.scrollTop;layer.querySelector('h2').textContent=active().title+(pm.form?.kind==='preview'?' — Document preview':' — Payments & Timeline');const close=layer.querySelector('.pm-close');close.dataset.pm=pm.form?.kind==='preview'?'cancel-editor':'close';close.setAttribute('aria-label',pm.form?.kind==='preview'?'Close preview':'Close payments workspace');layer.querySelector('#pm-save-status').textContent=pm.notice||'';const tabs=[['payments','Payments'],['calendar','Calendar'],['cash','Cash Flow'],['timeline','Timeline & Funding'],['vendors','Vendors'],['crew','Crew'],['cast','Cast'],['docs','Documents'],['downloads','Downloads']];layer.querySelector('.pm-tabs').innerHTML=tabs.map(([id,label])=>`<button type="button" data-pm="tab" data-id="${id}" aria-current="${pm.tab===id}">${pmTabIcon(id)}<span>${label}</span></button>`).join('');let content='';if(pm.tab==='payments')content=pmPaymentsHTML();else if(pm.tab==='calendar')content=pmCalendarHTML();else if(pm.tab==='cash')content=pmCashHTML();else if(pm.tab==='timeline')content=pmTimelineHTML();else if(['vendors','crew','cast'].includes(pm.tab))content=pm.vendorPage&&pmVendor(pm.vendorPage)?pmVendorDashboardHTML(pm.vendorPage):pmVendorsHTML();else if(pm.tab==='docs')content=pmDocsHTML();else content=pmDownloadsHTML();body.classList.toggle('pm-editing',!!pm.form&&pm.form.kind!=='preview');body.innerHTML=pm.form?pmEditorHTML():content;body.scrollTop=pm.form?0:scroll;pmModeFields();if(pm.form?.kind==='zip')pmApplyZipFilters();if(!pm.form&&['vendors','crew','cast','docs'].includes(pm.tab))pmApplyLibraryFilters(pm.tab==='docs'?'docs':'vendors');if(!pm.form&&pm.tab==='calendar')pmInitCalendar();}
   function pmDisable(control,disabled,reason){if(!control)return;control.disabled=disabled;control.setAttribute('aria-disabled',String(disabled));const label=control.closest('label')||control.parentElement;if(disabled){control.dataset.tooltip=reason;control.setAttribute('aria-description',reason);label.dataset.tooltip=reason;label.classList.add('pm-inactive');}else{delete control.dataset.tooltip;control.removeAttribute('aria-description');delete label.dataset.tooltip;label.classList.remove('pm-inactive');}}
   function pmModeFields(){const form=document.querySelector('#pm-layer form[data-pm-form="editor"]');if(!form)return;const mode=form.querySelector('[name="mode"]'),dateMode=form.querySelector('[name="dateMode"]');if(mode){const fixed=mode.value==='fixed',percent=mode.value==='percent';form.querySelector('.pm-fixed-fields').hidden=!fixed;pmDisable(form.querySelector('[name="lineId"]'),fixed,'Fixed payments use the line allocations below. Choose Percentage or Remaining balance to use this field.');pmDisable(form.querySelector('[name="component"]'),fixed,'For fixed payments, split base and fringe amounts in the allocation table below.');pmDisable(form.querySelector('[name="percent"]'),!percent,'Percentage is only used when Amount type is Percentage.');form.querySelectorAll('.pm-fixed-fields input').forEach(el=>pmDisable(el,!fixed,'Fixed allocations are not used for Percentage or Remaining balance payments.'));}
