   function pmStatus(label,kind){const color=label==='Attached'||label==='Assigned'?'green':label==='Archived'&&kind==='docs'?'red':'yellow';return `<span class="pm-status">${esc(label)}<span class="pm-status-dot pm-status-${color}" aria-hidden="true"></span></span>`;}
   function pmColumnFilters(kind,columns){const values=kind==='vendors'?(pm.vendorColumns||{}):(pm.docColumns||{});return columns.map(([id,label,status])=>`<th scope="col"><span>${label}</span>${status?`<select name="${kind}Col:${id}" aria-label="Filter ${kind==='docs'?'documents':kind} by ${label}">${pmOpts(status.map(name=>({id:name,name})),values[id]||'','All statuses')}</select>`:`<input type="search" name="${kind}Col:${id}" aria-label="Filter ${kind==='docs'?'documents':kind} by ${label}" value="${esc(values[id]||'')}" placeholder="Filter ${label.toLowerCase()}">`}</th>`).join('');}
