literal 0
HcmV?d00001

diff --git a/index.html b/index.html
index f4d89f6..01e3bdc 100644
--- a/index.html
+++ b/index.html
@@ -909,7 +909,7 @@
   "use strict";
 
   var STORE_KEY = "no-longer-budget-v9";
-  var APP_VERSION = "1.14.0"; // Semantic version: +0.0.1 bug fixes, +0.1.0 new features, +1.0.0 major releases. Bump with each change and log it in the Build Log.
+  var APP_VERSION = "1.15.0"; // Semantic version: +0.0.1 bug fixes, +0.1.0 new features, +1.0.0 major releases. Bump with each change and log it in the Build Log.
   var GROUPS = [
     { value: "ATL", label: "ATL" },
     { value: "BT", label: "BTL" },
@@ -5936,7 +5936,7 @@
   }
   document.addEventListener('mouseover', function (e) {
     var el = e.target.closest ? e.target.closest('[data-tooltip], [aria-label]') : null;
-    if (!el || el.matches('[role="dialog"], nav, [role="navigation"]')) return;
+    if (!el || el.matches('[role="dialog"], nav, [role="navigation"], [data-no-tooltip]')) return;
     var text = el.getAttribute('data-tooltip') || el.getAttribute('aria-label');
     if (!text) return;
     clearTooltipTimer();
@@ -5949,7 +5949,7 @@
   }, true);
   document.addEventListener('mouseout', function (e) {
     var el = e.target.closest ? e.target.closest('[data-tooltip], [aria-label]') : null;
-    if (!el || el.matches('[role="dialog"], nav, [role="navigation"]')) return;
+    if (!el || el.matches('[role="dialog"], nav, [role="navigation"], [data-no-tooltip]')) return;
     clearTooltipTimer();
   }, true);
   document.addEventListener('mousedown', clearTooltipTimer, true);
@@ -6001,7 +6001,7 @@
   const pmVendorLabel=id=>(pmVendor(id)||{}).name||'Unassigned vendor';
   const pmLabel=id=>{const r=pmRow(id);return r?`${r.account.num} / ${r.sub.num} — ${r.line.description||'Untitled line'}`:'Missing line';};
   const pmBtn=(action,label,id='',cls='')=>`<button type="button" data-pm="${action}" data-id="${esc(id)}" class="${cls}" aria-label="${esc(action==='cancel-editor'?(pm.form?.kind==='preview'?'Close preview':'Close editor'):label)}">${label}</button>`;
-  const pmOpts=(items,value,blank)=>`${blank!=null?`<option value="">${esc(blank)}</option>`:''}`+items.map(x=>`<option value="${esc(x.id)}"${x.id===value?' selected':''}>${esc(x.name)}</option>`).join('');
+  const pmOpts=(items,value,blank)=>`${blank!=null?`<option value="">${esc(blank)}</option>`:''}`+items.map(x=>`<option value="${esc(x.id)}"${x.id===value?' selected':''}${x.archived?' hidden':''}>${esc(x.name)}${x.archived?' (Archived)':''}</option>`).join('');
   const pmInput=(name,label,value='',type='text',extra='')=>`<label class="pm-field"><span class="pm-field-label">${label}</span><input name="${name}" aria-label="${label}" type="${type==='number'?'text':type}"${type==='number'?' inputmode="decimal" data-pm-numeric="true"':''} value="${esc(String(value==null?'':value))}" ${extra}></label>`;
   const pmSelect=(name,label,items,value,blank)=>`<label class="pm-field"><span class="pm-field-label">${label}</span><select name="${name}" aria-label="${label}">${pmOpts(items,value,blank)}</select></label>`;
   const pmAmount=a=>fmt(PC.money(a));
@@ -6013,13 +6013,13 @@
   function pmMatch(id){const r=pmRow(id);if(!r)return false;return(!pm.account||r.account.id===pm.account)&&(!pm.sub||r.sub.id===pm.sub)&&(!pm.vendor||r.line.vendorId===pm.vendor)&&(!pm.line||id===pm.line);}
   function pmVisible(p){const ids=p.mode==='fixed'?(p.allocations||[]).map(a=>a.lineId):[p.lineId];return ids.some(pmMatch);}
   function pmParts(p){return PC.parts(active(),p,pmCalc).filter(a=>pmMatch(a.lineId));}
-  function pmOpen(tab='payments',line=''){if(tab==='exports')tab='downloads';pm.rangeMode='month';pm.rangeFrom=null;pm.rangeTo=null;pm.includeSensitive=false;pm.downloadError='';if(!active())return;pm.tab=tab;pm.parent=null;pm.stage='';pm.vendorPage='';pm.line=line;pm.account='';pm.sub='';pm.vendor='';pm.form=null;pm.notice='';pm.timelineEditing=undefined;pm.vendorColumns={};pm.docColumns={};pm.vendorQuery='';pm.docQuery='';pmCF();let layer=document.getElementById('pm-layer');if(!layer){layer=document.createElement('div');layer.id='pm-layer';layer.className='pm-backdrop';layer.innerHTML='<section class="pm-workspace" role="dialog" aria-modal="true" aria-label="Payments and production timeline"><div class="pm-head"><h2></h2><span id="pm-save-status" class="pm-save-status" role="status" aria-live="polite"></span><button type="button" class="icon-btn pm-close" data-pm="close" aria-label="Close payments workspace">×</button></div><nav class="pm-tabs" aria-label="Payment workspace tabs"></nav><div class="pm-body"></div><div class="pm-footer-note">Local on this computer · Export .nlb includes documents · Posted payments use corrections/reversals, not Undo.</div></section>';document.body.appendChild(layer);}layer.hidden=false;closeSetupMenu();closeRowMenu();pmRender();layer.querySelector('[data-pm="close"]').focus();}
+  function pmOpen(tab='payments',line=''){if(tab==='exports')tab='downloads';pm.rangeMode='month';pm.mainMode='month';pm.mainFrom=null;pm.mainTo=null;pm.calendarAnchor='';pm.vendorMonth='';pm.rangeFrom=null;pm.rangeTo=null;pm.includeSensitive=false;pm.downloadError='';if(!active())return;pm.tab=tab;pm.parent=null;pm.stage='';pm.vendorPage='';pm.line=line;pm.account='';pm.sub='';pm.vendor='';pm.form=null;pm.notice='';pm.timelineEditing=undefined;pm.vendorColumns={};pm.docColumns={};pm.vendorQuery='';pm.docQuery='';pmCF();let layer=document.getElementById('pm-layer');if(!layer){layer=document.createElement('div');layer.id='pm-layer';layer.className='pm-backdrop';layer.innerHTML='<section class="pm-workspace" role="dialog" aria-modal="true" aria-label="Payments and production timeline"><div class="pm-head"><h2></h2><span id="pm-save-status" class="pm-save-status" role="status" aria-live="polite"></span><button type="button" class="icon-btn pm-close" data-pm="close" aria-label="Close payments workspace">×</button></div><nav class="pm-tabs" aria-label="Payment workspace tabs"></nav><div class="pm-body"></div><div class="pm-footer-note">Local on this computer · Export .nlb includes documents · Posted payments use corrections/reversals, not Undo.</div></section>';document.body.appendChild(layer);}layer.hidden=false;closeSetupMenu();closeRowMenu();pmRender();layer.querySelector('[data-pm="close"]').focus();}
   function pmClose(){const el=document.getElementById('pm-layer');if(el)el.hidden=true;if(pm.preview)URL.revokeObjectURL(pm.preview);pm.preview=null;pm.form=null;render();}
   function pmStats(){const b=active(),cf=pmCF(),ex=pmRows().reduce((v,r)=>{const h=PC.hot(b,r.line.id,pmCalc);return v+h.base+h.fringe;},0),paid=PC.sum(cf.ledger,e=>e.amount)+PC.sum(Object.values(cf.lineMeta),m=>(m.openingBase||0)+(m.openingFringe||0)),uns=PC.sum(PC.unscheduled(b,pmCalc),r=>r.base+r.fringe),reserve=PC.reserve(b,pmCalc);const warnings=pmRows().filter(r=>{const ex=PC.expected(b,r.line.id,pmCalc);return ['base','fringe'].some(c=>PC.net(b,r.line.id,c)>ex[c]+.009||PC.net(b,r.line.id,c)+PC.scheduled(b,r.line.id,pmCalc,c)>ex[c]+.009);});return`<div class="pm-stats">${[['Expected final cost',ex],['Net paid',paid],['Not scheduled yet',uns],['Contingency reserve remaining',reserve.remaining]].map(([l,v])=>`<div class="pm-stat"><small>${l}</small><strong>${pmAmount(v)}</strong></div>`).join('')}</div>${warnings.length?'<div class="pm-alert">Overpaid or overallocated against approved expected costs: '+warnings.map(r=>esc(pmLabel(r.line.id))).join('; ')+'. Review installments and approved invoice costs. The forecast retains the higher commitment.</div>':''}${reserve.exceeded?'<div class="pm-alert">Reserve allocations exceed contingency. Review the allocated amounts before relying on the cash forecast.</div>':''}`;}
