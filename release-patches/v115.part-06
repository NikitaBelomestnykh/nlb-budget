+  function contactCsvValidate(text){let quoted=false,fieldStart=true,closed=false;for(let i=0;i<text.length;i++){const c=text[i];if(quoted){if(c==='"'){if(text[i+1]==='"')i++;else{quoted=false;closed=true;}}continue;}if(c==='"'){if(!fieldStart||closed)throw Error('Invalid quote in CSV. Check the file and try again.');quoted=true;fieldStart=false;continue;}if(c===','||c==='\n'||c==='\r'){fieldStart=true;closed=false;if(c==='\r'&&text[i+1]==='\n')i++;continue;}if(closed&&!/\s/.test(c))throw Error('Unexpected text after a quoted CSV field.');if(!/\s/.test(c))fieldStart=false;}if(quoted)throw Error('A quoted CSV field is not closed.');}
+  async function contactCsvLoad(file){if(!file)return;try{if(file.size>5*1024*1024)throw Error('Choose a CSV file of 5 MB or less.');const text=(await file.text()).replace(/^\uFEFF/,'');contactCsvValidate(text);const rows=parseCsvText(text);if(rows.length<2)throw Error('The CSV needs a header row and at least one contact.');if(rows.length>10001)throw Error('Import at most 10,000 contacts at a time.');const headers=rows.shift().map((x,i)=>String(x||'').trim()||'Column '+(i+1));if(headers.length>100)throw Error('Import at most 100 columns at a time.');const useful=rows.filter(row=>row.some(x=>String(x||'').trim()));if(useful.some(row=>row.length>headers.length))throw Error('A CSV row has more columns than the header. Check for stray commas.');if(!useful.length)throw Error('No contact rows found.');const aliases={name:['name','displayname','fullname'],legalName:['legalname','payeename'],contact:['contact','contactname'],email:['email','emailaddress'],phone:['phone','phonenumber'],address:['address'],terms:['terms','paymentterms','defaultpaymentterms'],notes:['notes','note'],dietaryPreferences:['dietarypreferences','dietarypreference','diet'],allergies:['allergies','allergy']},mapping={};for(const [key] of contactCsvFields){const n=headers.findIndex(h=>(aliases[key]||[]).includes(h.toLowerCase().replace(/[^a-z0-9]/g,'')));mapping[key]=n<0?'':String(n+1);}pm.form={kind:'contact-csv',value:{headers,rows:useful,mapping,category:pm.tab,filename:file.name}};pmRender();}catch(e){pmError(e);}}
+  function pmEditorHTML(){const f=pm.form,cf=pmCF();let fields='',title='',kind=f.kind;const p=f.value||{};if(kind==='calendar-day'||kind==='vendor-calendar-day'){const items=(kind==='calendar-day'?pmCalendarEvents(pmMainRange()):vdCalendarEvents(vdLines(pm.vendorPage))).filter(e=>e.date===p.date);return `<div class="pm-editor"><div class="pm-editor-heading"><h3>${esc(p.date)} · ${items.length} transactions</h3>${pmBtn('cancel-editor','Close')}</div>${items.map(pmEventHTML).join('')}</div>`;}if(kind==='contact-csv'){title='Import '+(p.category==='crew'?'crew':'cast')+' from CSV';const options=p.headers.map((name,i)=>({id:String(i+1),name:(i+1)+'. '+name}));fields=`<p>Map each contact field to a CSV column. Import creates new contacts only; it does not overwrite existing contacts, attach documents or link budget lines. Review for duplicates before importing.</p><p><b>${esc(p.filename)}</b> · ${p.rows.length} rows. Private details remain on this computer and are included in backups.</p><div class="pm-grid">${contactCsvFields.map(([key,label])=>pmSelect('map:'+key,label,options,p.mapping[key]||'','Do not import')).join('')}</div><h4>CSV preview (first 3 rows)</h4><div class="pm-scroll"><table class="pm-table"><thead><tr>${p.headers.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${p.rows.slice(0,3).map(row=>`<tr>${p.headers.map((_,i)=>`<td>${esc(String(row[i]||''))}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;}else if(kind==='vendor'){title=p.id?'Edit contact':pm.tab==='crew'?'Create crew member':pm.tab==='cast'?'Create cast member':'Create vendor';const roles=p.id?vdRoles(p):[(['crew','cast'].includes(pm.tab)?pm.tab:'vendors')];fields=`<div class="vd-logo-editor"><input type="file" id="vd-logo-upload" accept="image/png,image/jpeg,image/webp,image/gif" hidden><button type="button" class="vd-logo-edit" data-pm="vendor-logo-upload" aria-label="${p.logoDataUrl?'Change logo':'Upload logo'}">${p.logoDataUrl?vdLogoHTML(p):'<span class="vd-logo-plus" aria-hidden="true">+</span>'}</button><span>${p.logoDataUrl?'Change logo':'Add logo'} · saved with contact</span>${p.logoDataUrl?pmBtn('vendor-logo-remove','Remove logo'):''}</div><fieldset class="pm-contact-roles"><legend>Contact category</legend>${[['vendors','Vendor'],['crew','Crew'],['cast','Cast']].map(([id,label])=>`<label><input type="radio" name="contactRole" value="${id}" required${roles.length===1&&roles[0]===id?' checked':''}> ${label}</label>`).join('')}<p class="pm-note">${roles.length>1?'This existing contact appears in multiple categories. Choose one when saving; its history and documents stay intact.':'Choose one category.'}</p></fieldset><div class="pm-grid">${pmInput('name','Vendor / display name',p.name||'','text','required')}${pmInput('legalName','Legal / payee name',p.legalName||'')}${pmInput('contact','Contact name',p.contact||'')}${pmInput('email','Email',p.email||'','email')}${pmInput('phone','Phone',p.phone||'')}${pmInput('address','Address',p.address||'')}${pmInput('terms','Default payment terms',p.terms||'')}${pmInput('notes','Notes',p.notes||'')}${pmInput('dietaryPreferences','Dietary preferences',p.dietaryPreferences||'')}${pmInput('allergies','Allergies',p.allergies||'')}</div>`;}
  else if(kind==='vendor-link'){title='Link budget lines';const rows=pmRows().filter(r=>!lcIdentity(r.line.id));fields=`<p>Choose unassigned lines from ${esc(active().title)}. Lines already assigned to another vendor are not changed.</p><div class="vd-link-list">${rows.map(r=>`<label class="vd-link-option"><input type="checkbox" name="vendorLine" value="${esc(r.line.id)}"><span><b>${esc(r.line.description||'Untitled line')}</b><small>${esc(r.account.num+' / '+r.sub.num+' — '+r.sub.name)} · ${pmAmount(pmCalc.base(r.line)+pmCalc.fringe(r.line,pmCalc.base(r.line)))}</small></span></label>`).join('')||'<p>There are no unassigned detail lines in this budget.<