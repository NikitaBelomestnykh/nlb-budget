+  function vdValidateAgreementData(vendors,data){const expected=[];for(const v of vendors){if(v.agreements!=null&&!Array.isArray(v.agreements))throw Error('Invalid vendor agreements.');const seen=new Set();for(const a of vdAgreementList(v)){if(!a||typeof a.id!=='string'||!a.id||seen.has(a.id)||typeof a.originalName!=='string'||!a.originalName||typeof a.type!=='string'||!Number.isInteger(a.size)||a.size<0||a.size>100*1024*1024)throw Error('Invalid agreement metadata.');seen.add(a.id);expected.push({vendor:v,doc:a});}}if(data==null&&expected.length===0)return[];if(!Array.isArray(data)||data.length!==expected.length)throw Error('Vendor agreement originals are missing or incomplete.');const seen=new Set(),originals=[];for(const entry of data){const key=JSON.stringify([entry?.vendorId,entry?.agreementId]);if(seen.has(key))throw Error('Duplicate agreement original.');seen.add(key);const match=expected.find(x=>x.vendor.id===entry.vendorId&&x.doc.id===entry.agreementId);if(!match||typeof entry.base64!=='string'||(!entry.base64&&match.doc.size>0)||!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(entry.base64))throw Error('Invalid agreement original.');const blob=pmDecode(entry.base64,match.doc.type);if(blob.size!==match.doc.size)throw Error('Agreement bytes do not match '+match.doc.originalName);originals.push({doc:match.doc,blob});}return originals;}
