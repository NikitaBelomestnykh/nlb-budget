   async function pmBlob(d){let blob=await pmStore('get',d.key);if(!blob&&d.sampleAsset&&d.key.startsWith('demo-')){const file=window.NLBExample.files[d.sampleAsset];if(file&&file.size===d.size&&file.type===d.type){blob=pmDecode(file.base64,file.type);await pmStore('put',d.key,blob);}}if(!blob)throw Error('Missing document: '+d.originalName+'. Restore a full backup or re-upload before exporting.');return blob;}
