   function pmSafeFile(s){return String(s||'Document').replace(/[<>:"/\\|?*\x00-\x1f]/g,'_').replace(/^\.+/,'').slice(0,150)||'Document';}
   const pmBase64=blob=>new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]);r.onerror=()=>reject(r.error);r.readAsDataURL(blob);});
   function pmDecode(base64,type){const bin=atob(base64),bytes=Uint8Array.from(bin,c=>c.charCodeAt(0));return new Blob([bytes],{type});}
