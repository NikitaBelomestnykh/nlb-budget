+  async function vdUpload(files){const vendor=pmVendor(pm.vendorPage),before=JSON.stringify(state),added=[];if(!vendor||!files.length)return;try{pm.busy=true;for(const file of files){if(file.size>100*1024*1024)throw Error(file.name+' exceeds the 100 MB per-file limit.');const a={id:pmId(),key:pmId(),originalName:file.name,type:file.type||(/\.pdf$/i.test(file.name)?'application/pdf':'application/octet-stream'),size:file.size,uploadedAt:new Date().toISOString()};await pmStore('put',a.key,file);added.push(a);}if(before!==JSON.stringify(state))throw Error('The workspace changed during upload. Try again.');if(!pmCommit(()=>{const v=pmVendor(vendor.id);if(!v)throw Error('Vendor no longer exists.');v.agreements=(v.agreements||[]).concat(added);})){for(const a of added)await pmStore('delete',a.key);}}catch(e){for(const a of added)await pmStore('delete',a.key);pmError(e);}finally{pm.busy=false;pmRender();}}
