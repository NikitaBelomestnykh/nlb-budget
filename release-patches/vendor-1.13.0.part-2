   function pmDB(){if(!pmDBPromise)pmDBPromise=new Promise((resolve,reject)=>{const req=indexedDB.open('nlb-document-store-v1',1);req.onupgradeneeded=()=>req.result.createObjectStore('files');req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);});return pmDBPromise;}
   async function pmStore(op,key,value){const db=await pmDB();return new Promise((resolve,reject)=>{const tx=db.transaction('files',op==='get'?'readonly':'readwrite'),store=tx.objectStore('files');const req=op==='put'?store.put(value,key):op==='delete'?store.delete(key):store.get(key);let result;req.onsuccess=()=>result=req.result;tx.oncomplete=()=>resolve(result);tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error||Error('Document storage aborted.'));});}
   async function pmUpload(files){const b=active(),cf=PC.ensure(b);const added=[];try{pm.busy=true;for(const file of files){if(file.size>100*1024*1024)throw Error(file.name+' exceeds the 100 MB per-document limit.');const id=pmId(),key=pmId();await pmStore('put',key,file);added.push({id,key,originalName:file.name,internalName:file.name,tags:[],links:pm.line?[{kind:'line',id:pm.line}]:[],internal:true,type:file.type||(/\.pdf$/i.test(file.name)?'application/pdf':'application/octet-stream'),size:file.size,uploadedAt:new Date().toISOString()});}if(!pmCommit(()=>cf.documents.push(...added)))for(const d of added)await pmStore('delete',d.key);}catch(e){for(const d of added)await pmStore('delete',d.key);pmError(e);}finally{pm.busy=false;pmRender();}}
