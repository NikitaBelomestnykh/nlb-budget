;}
+  function pmCashHTML(){const cf=pmCF(),reserve=PC.reserve(active(),pmCalc),events=PC.events(active(),pmCalc),dated=events.filter(e=>e.date&&(!cf.openingDate||e.date>=cf.openingDate));let balance=Number(cf.openingCash)||0;let rows=dated.map(e=>{balance=PC.money(balance+e.amount);return`<tr><td>${esc(e.date)}</td><td>${esc(e.type)}</td><td>${esc(e.label)}</td><td class="pm-money">${e.amount>0?pmAmount(e.amount):'—'}</td><td class="pm-money">${e.amount<0?pmAmount(-e.amount):'—'}</td><td class="pm-money ${balance<0?'variance-over':''}">${pmAmount(balance)}</td></tr>`;}).join('');let dayBalance=Number(cf.openingCash)||0,firstShort=null;for(const d of [...new Set(dated.map(e=>e.date))].sort()){dayBalance=PC.money(dayBalance+PC.sum(dated.filter(e=>e.date===d),e=>e.amount));if(dayBalance<-.009&&!firstShort)firstShort={date:d,amount:-dayBalance};}const uns=PC.sum(PC.unscheduled(active(),pmCalc),r=>r.base+r.fringe),undated=PC.sum(events.filter(e=>!e.date&&e.amount<0),e=>-e.amount),undatedFunds=PC.sum(events.filter(e=>!e.date&&e.amount>0),e=>e.amount);return pmStats()+`<p class="pm-note">Budget-wide forecast. Opening ${pmAmount(cf.openingCash)} as of ${esc(cf.openingDate||'the start of all recorded movements')}. Received funds and future expected funds are labeled separately; expected funding is not money already in the bank.</p><div class="pm-alert">Not scheduled yet: ${pmAmount(uns+undated)} outgoing (${pmAmount(uns)} unallocated + ${pmAmount(undated)} installments wi