 .schedule-layout{display:grid;gap:12px}.schedule-section{border:1px solid var(--border);border-radius:10px;padding:18px;background:var(--row-alt)}.schedule-section-heading{display:flex;align-items:center;gap:12px;margin-bottom:16px}.schedule-section-heading>span{display:grid;place-items:center;flex:none;width:32px;height:32px;border-radius:50%;background:var(--accent);color:#161616;font-size:11px;font-weight:700}.schedule-section-heading h4{margin:0}.schedule-section-heading p{color:var(--text-2);margin:3px 0 0;font-size:13px}.schedule-section .pm-grid{align-items:end}.schedule-section .pm-fixed-fields{margin-top:18px}.schedule-section .pm-fixed-fields>h4{margin:0 0 4px}.schedule-section .pm-allocation-table{background:var(--bg)}.schedule-section [hidden]{display:none!important}.schedule-section .pm-vendor-picker{align-items:end}@media(max-width:700px){.schedule-section{padding:14px}}
 /* Keep long allocation lists contained so date and notes remain easy to reach. */
 .schedule-section .pm-fixed-fields>.pm-scroll{max-height:300px;overflow:auto}
+
+/* Dated payment markers in the budget-wide timeline. */
+.pt-scroll{max-height:620px;overflow:auto}.pt-account-group{margin:16px 0 4px;padding:7px 10px;background:var(--row-alt);border-radius:6px;font-weight:700;position:sticky;left:0;width:220px}.pt-line-row .pt-label small{font-size:11px}.pm-body .pt-payment-marker{position:absolute;z-index:2;transform:translateX(-50%);width:13px;height:13px;min-height:0;padding:0;border:1px solid var(--canvas);border-radius:50%}.pm-body .pt-payment-due{background:#e6a631}.pm-body .pt-payment-paid{background:#52b76e}.pm-body .pt-payment-marker:focus-visible{outline:2px solid var(--text);outline-offset:2px}.pm-cash-shortfall{border-color:#d7594e}.pt-overview .pt-scroll .pt-axis{position:sticky;top:0;z-index:5;background:var(--canvas)}
