     const values=fields.map(m=>({name:m.name,key:m.id,value:cf.phases[m.id]||'',type:'date'})).concat([{name:'Opening cash as of',key:'openingDate',value:cf.openingDate||'',type:'date'},{name:'Opening cash amount',key:'openingCash',value:cf.openingCash||0,type:'number'}]);
