+const tmp=fs.mkdtempSync(path.join(os.tmpdir(),'nlb-visual-'));const sample=Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/a1sAAAAASUVORK5CYII=','base64');
