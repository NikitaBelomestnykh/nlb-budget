+let cards=p.locator('.vd-vendor-card'),camera=cards.filter({hasText:'Example Camera Rentals'});assert.equal(await cards.filter({hasText:'Example Retired Supplier'}).count(),0,'archived example hidden');await camera.locator('[data-pm="vendor-dashboard"]').click();let [chooser]=await Promise.all([p.waitForEvent('filechooser'),p.locator('[data-pm="vendor-logo-upload"]').click()]);assert(await chooser.element().evaluate(e=>e.isConnected));await chooser.setFiles({name:'company.png',mimeType:'image/png',buffer:sample});await p.waitForFunction(()=>document.querySelector('.vd-dashboard-identity img'));assert.match(await p.locator('#pm-save-status').innerText(),/logo saved/i);
+let state=await p.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9'))),logo=state.vendors.find(v=>v.name==='Example Camera Rentals').logoDataUrl;assert(logo.startsWith('data:image/png;base64,'));await p.reload();await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="vendors"]').click();camera=cards.filter({hasText:'Example Camera Rentals'});assert.equal(await camera.locator('img.vd-logo').count(),1);const pos=await cards.evaluateAll(xs=>xs.filter(x=>getComputedStyle(x).display!=='none').slice(0,4).map(x=>({bottom:x.getBoundingClientRect().bottom,actions:x.querySelector('.vd-card-actions').getBoundingClientRect().bottom})));for(const x of pos)assert(Math.abs((x.bottom-x.actions)-17)<2,'card buttons need equal bottom margin');
+// Sample archive disappears, while ordinary vendor archive remains available.
+await camera.locator('[data-pm="archive-vendor"]').click();assert.equal(await cards.filter({hasText:'Example Camera Rentals'}).count(),0);await p.locator('[data-pm="new-vendor"]').click();await p.locator('input[name="name"]').last().fill('Real Vendor');await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();await p.locator('[data-pm="vendors-overview"]').click();await cards.filter({hasText:'Real Vendor'}).locator('[data-pm="archive-vendor"]').click();assert.equal(await cards.filter({hasText:'Real Vendor'}).locator('[data-pm="archive-vendor"]').innerText(),'Unarchive');
+await p.locator('[data-pm="tab"][data-id="downloads"]').click();const [dl]=await Promise.all([p.waitForEvent('download'),p.locator('[data-pm="clarity-workspace-backup"]').click()]);const fn=path.join(tmp,'workspace.json');await dl.saveAs(fn);assert.equal(JSON.parse(fs.readFileSync(fn)).vendors.find(v=>v.name==='Example Camera Rentals').logoDataUrl,logo);
+const q=await browser.newPage();q.on('dialog',d=>d.accept());await q.goto('file://'+path.resolve(__dirname,'../index.html'));await q.locator('[data-action="open-import"]').click();await q.locator('#import-nlb-input').setInputFiles(fn);await q.locator('[data-action="import-nlb"]').click();await q.locator('[data-action="confirm-ok"]').click();await q.waitForFunction(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9')).budgets.some(b=>b.title.endsWith('(Imported)')));const imported=await q.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9')));assert(imported.vendors.some(v=>v.name==='Example Camera Rentals'&&v.logoDataUrl===logo),'logo survives full workspace restore');await q.close();
+await p.locator('[data-pm="close"]').click();await p.locator('[data-action="open-help"]').click();await p.locator('[data-action="restore-sample-budget"]').click();await p.locator('[data-action="close-help"]').click();await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="vendors"]').click();assert.equal(await cards.filter({hasText:'Example Camera Rentals'}).count(),1,'restore full example makes archived sample vendor visible');assert.equal(await cards.filter({hasText:'Example Camera Rentals'}).locator('img.vd-logo').count(),1,'restoration preserves logo');assert.deepEqual(errors,[]);console.log('PASS logos, workspace restore, card alignment and example-vendor archive');}finally{await browser.close();fs.rmSync(tmp,{recursive:true,force:true})}})().catch(e=>{console.error(e);process.exitCode=1});
