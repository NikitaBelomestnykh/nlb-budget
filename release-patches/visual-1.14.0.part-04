--- /dev/null
+++ b/tests/crew-cast.test.cjs
@@ -0,0 +1,3 @@
+const assert=require('node:assert/strict'),path=require('node:path'),fs=require('node:fs'),os=require('node:os');const {chromium}=require('playwright');
+(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});const tmp=fs.mkdtempSync(path.join(os.tmpdir(),'nlb-contact-'));try{const p=await browser.newPage({acceptDownloads:true}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="crew"]').click();assert.match(await p.locator('.vd-vendors-intro h3').innerText(),/Crew/);await p.locator('[data-pm="new-vendor"]').click();await p.locator('input[name="name"]').last().fill('Jordan Individual');assert(await p.locator('[name="contactRole"][value="crew"]').isChecked());await p.locator('[name="contactRole"][value="cast"]').check();await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();assert.match(await p.locator('.vendor-dashboard h3').first().innerText(),/Jordan/);
+const [chooser]=await Promise.all([p.waitForEvent('filechooser'),p.locator('[data-pm="vendor-upload"]').click()]);await chooser.setFiles([{name:'deal-memo.txt',mimeType:'text/plain',buffer:Buffer.from('signed deal memo')},{name:'w9.txt',mimeType:'text/plain',buffer:Buffer.from('private form')}]);await p.waitForFunction(()=>document.querySelectorAll('.vd-agreements article').length===2);let state=await p.evaluate(()=>JSON.parse(localStorage.getItem('no-longer-budget-v9'))),v=state.vendors.find(x=>x.name==='Jordan Individual');assert.deepEqual(v.roles,['crew','cast']);assert.equal(v.agreements.length,2);const id=v.id;await p.locator('[data-pm="tab"][data-id="cast"]').click();assert.equal(await p.locator('.vd-vendor-card').filter({hasText:'Jordan Individual'}).count(),1);await p.locator('.vd-vendor-card').filter({hasText:'Jordan Individual'}).locator('[data-pm="vendor-dashboard"]').click();assert.equal(await p.locator('.vd-agreements article').count(),2);await p.locator('[data-pm="tab"][data-id="vendors"]').click();assert.equal(await p.locator('.vd-vendor-card').filter({hasText:'Jordan Individual'}).count(),0);await p.locator('[data-pm="tab"][data-id="downloads"]').click();const [dl]=await Promise.all([p.waitForEvent('download'),p.locator('[data-pm="clarity-workspace-backup"]').click()]);const fn=path.join(tmp,'workspace.json');await dl.saveAs(fn);const backup=JSON.parse(fs.readFileSync(fn));assert.deepEqual(backup.vendors.find(x=>x.id===id).roles,['crew','cast']);assert.equal(backup.vendorAgreementData.filter(a=>a.vendorId===id).length,2);await p.reload();await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="cast"]').click();assert.equal(await p.locator('.vd-vendor-card').filter({hasText:'Jordan Individual'}).count(),1);assert.deepEqual(errors,[]);console.log('PASS crew/cast categories, shared contact, attachments and workspace backup');}finally{await browser.close();fs.rmSync(tmp,{recursive:true,force:true});}})().catch(e=>{console.error(e);process.exitCode=1});
