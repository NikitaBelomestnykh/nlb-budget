diff --git a/tests/timeline-calendar.test.cjs b/tests/timeline-calendar.test.cjs
new file mode 100644
index 0000000..785891e
--- /dev/null
+++ b/tests/timeline-calendar.test.cjs
@@ -0,0 +1,5 @@
+const assert=require('node:assert/strict'),path=require('node:path'),{chromium}=require('playwright');
+(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{const p=await browser.newPage({viewport:{width:1440,height:900}}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="timeline"]').click();assert(await p.locator('.pt-row').count()>=3);assert(await p.locator('.pt-bar').count()>=1);const heading=p.locator('.pm-heading-toolbar').first();const boxes=await heading.evaluate(el=>{const a=el.querySelector('h3').getBoundingClientRect(),b=el.querySelector('button').getBoundingClientRect();return [a.top+a.height/2,b.top+b.height/2]});assert(Math.abs(boxes[0]-boxes[1])<1,'heading and button centers align');
+await p.locator('[data-pm="tab"][data-id="calendar"]').click();await p.locator('[name="calendarMonth"]').fill('2026-11');const stream=p.locator('.pm-calendar-stream');assert.equal(await p.locator('.pm-month-panel').count(),3);const start=await p.locator('[name="calendarMonth"]').inputValue();assert.equal(start,'2026-11');
+for(let i=0;i<25;i++){await stream.evaluate(e=>e.scrollTop=e.scrollHeight);await p.waitForTimeout(25)}let months=await p.locator('.pm-month-panel').evaluateAll(es=>es.map(e=>e.dataset.month));assert(months.at(-1)>'2027-11','continuous forward months');assert(months.length<=18,'rendered months remain bounded');
+for(let i=0;i<32;i++){await stream.evaluate(e=>e.scrollTop=0);await p.waitForTimeout(25)}months=await p.locator('.pm-month-panel').evaluateAll(es=>es.map(e=>e.dataset.month));assert(months[0]<'2026-11','continuous backward months');assert(months.length<=18);const current=await p.locator('[name="calendarMonth"]').inputValue();await p.locator('[data-pm="calendar-next"]').click();const after=await p.locator('[name="calendarMonth"]').inputValue();assert.notEqual(after,current,'next month changes selected export month');assert.equal(await p.locator('.pm-month-panel').count(),3);await p.locator('[data-pm="calendar-prev"]').click();assert.equal(await p.locator('[name="calendarMonth"]').inputValue(),current);assert.equal(await p.locator('.pm-tabs svg').count(),9);assert.deepEqual(errors,[]);console.log('PASS visual timeline, aligned headings, scrolling calendar and month controls');}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
diff --git a/tests/vendor-upload-button.test.cjs b/tests/vendor-upload-button.test.cjs
new file mode 100644
index 0000000..c6f1b3b
--- /dev/null
+++ b/tests/vendor-upload-button.test.cjs
@@ -0,0 +1,31 @@
+const assert=require('node:assert/strict'),path=require('node:path');
+const {chromium}=require('playwright');
+(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{
+ const page=await browser.newPage({viewport:{width:1440,height:900},acceptDownloads:true}),errors=[];
+ page.on('pageerror',e=>errors.push(e.message));
+ await page.goto('file://'+path.resolve(__dirname,'../index.html'));
+ await page.locator('[data-action="pm-open"]').click();
+ await page.locator('[data-pm="tab"][data-id="vendors"]').click();
+ await page.locator('[data-pm="new-vendor"]').click();
+ await page.locator('input[name="name"]').last().fill('Upload Button Test');
+ await page.locator('form[data-pm-form="editor"] button[type="submit"]').click();
+ await page.locator('.vendor-dash-heading').getByText('Upload Button Test').waitFor();
+ // The entire payment dialog must not inherit a tooltip from its accessibility label.
+ await page.locator('.vendor-dash-heading h3').hover(); await page.waitForTimeout(900);
+ assert.notEqual(await page.locator('.app-tooltip.visible').count(),1,'workspace label appeared as tooltip');
+ let [chooser]=await Promise.all([page.waitForEvent('filechooser'),page.locator('[data-pm="vendor-upload"]').click()]);
+ assert(await chooser.element().evaluate(el=>el.isConnected),'native picker input was destroyed before selection');
+ await chooser.setFiles([{name:'signed-a.pdf',mimeType:'application/pdf',buffer:Buffer.from('first signed original')},{name:'signed-b.pdf',mimeType:'application/pdf',buffer:Buffer.from('second signed original')}]);
+ await page.waitForFunction(()=>document.querySelectorAll('.vd-agreements article').length===2);
+ assert.match(await page.locator('#pm-save-status').innerText(),/2 agreements added/);
+ await page.reload();await page.locator('[data-action="pm-open"]').click();await page.locator('[data-pm="tab"][data-id="vendors"]').click();await page.locator('.vd-vendor-card').filter({hasText:'Upload Button Test'}).locator('[data-pm="vendor-dashboard"]').click();
+ assert.equal(await page.locator('.vd-agreements article').count(),2,'agreements survive restart');
+ const [download]=await Promise.all([page.waitForEvent('download'),page.locator('.vd-agreements article').first().getByRole('button',{name:'Download'}).click()]);
+ const stream=await download.createReadStream();let chunks=[];for await(const c of stream)chunks.push(c);assert.equal(Buffer.concat(chunks).toString(),'first signed original');
+ [chooser]=await Promise.all([page.waitForEvent('filechooser'),page.locator('[data-pm="vendor-upload"]').click()]);await chooser.setFiles([]);
+ [chooser]=await Promise.all([page.waitForEvent('filechooser'),page.locator('[data-pm="vendor-upload"]').click()]);await chooser.setFiles({name:'third.txt',mimeType:'text/plain',buffer:Buffer.from('third')});
+ await page.waitForFunction(()=>document.querySelectorAll('.vd-agreements article').length===3);assert.match(await page.locator('#pm-save-status').innerText(),/1 agreement added/);
+ // Explicit button labels still produce tooltips.
+ const btn=page.locator('[data-pm="vendor-upload"]');await btn.hover();await page.waitForTimeout(900);assert.match(await page.locator('.app-tooltip.visible').innerText(),/Add agreements/);
+ assert.deepEqual(errors,[]);console.log('PASS actual agreement picker, persistence, cancellation, downloads and tooltip behavior');
+ }finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
