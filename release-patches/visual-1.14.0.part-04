utton" data-pm="space-forward" aria-label="Forward to next space"${spaceNav.pos>=spaceNav.entries.length-1?' disabled aria-description="No next space in this open workspace."':''}>→</button></div><ol class="space-crumbs">${pieces.map(p=>'<li>'+p+'</li>').join('')}</ol>`;}
+  function spaceBar(){const layer=document.getElementById('pm-layer');if(!layer||layer.hidden)return;let bar=layer.querySelector('.space-nav');if(!bar){bar=document.createElement('nav');bar.className='space-nav';bar.setAttribute('aria-label','Workspace navigation');layer.querySelector('.pm-tabs').after(bar);}const pieces=[spaceCrumb(active().title,'space-budget'),spaceCrumb('Payments & Timeline','space-root')],target=lcTarget();pieces.push(spaceCrumb(spaceTabs[pm.tab]||pm.tab,'space-section',pm.tab,!target&&!pm.form&&!(['vendors','crew','cast'].includes(pm.tab)&&pm.vendorPage)));if(pm.tab==='payments'&&target){const r=target.kind==='line'?pmRow(target.id):target.kind==='sub'?LC.rows(active(),target)[0]:null;const account=r?.account||(target.kind==='account'?LC.entity(active(),target):null),sub=r?.sub||(target.kind==='sub'?LC.entity(active(),target):null);if(account)pieces.push(spaceCrumb(account.num+' '+account.name,'space-target','account:'+account.id,target.kind==='account'&&!pm.form));if(sub)pieces.push(spaceCrumb(sub.num+' '+sub.name,'space-target','sub:'+sub.id,target.kind==='sub'&&!pm.form));if(target.kind==='line')pieces.push(spaceCrumb(r?.line.description||'Untitled line','space-target','line:'+target.id,!pm.form));}
+ if(['vendors','crew','cast'].includes(pm.tab)&&pm.vendorPage&&pmVendor(pm.vendorPage))pieces.push(spaceCrumb(pmVendorLabel(pm.vendorPage),'vendor-dashboard',pm.vendorPage,!pm.form));if(pm.form){const f=pm.form,name=f.value?.internalName||f.value?.originalName||f.kind==='vendor'&&f.value?.name;if(name&&!f.agreementVendorId)pieces.push(spaceCrumb(name,f.kind==='vendor'?'space-vendor':'space-document',f.value.id));pieces.push(spaceCrumb(f.agreementVendorId?'Preview: '+name:spaceFormNames[f.kind]||'Edit','',null,true));}bar.innerHTML=`<div class="space-arrows"><button type="button" data-pm="space-back" aria-label="Back to previous space"${spaceNav.pos<=0?' disabled aria-description="No previous space in this open workspace."':''}>←</button><button type="button" data-pm="space-forward" aria-label="Forward to next space"${spaceNav.pos>=spaceNav.entries.length-1?' disabled aria-description="No next space in this open workspace."':''}>→</button></div><ol class="space-crumbs">${pieces.map(p=>'<li>'+p+'</li>').join('')}</ol>`;}
   function spaceSanitize(x){const cf=LC.ensure(active());if(x.line&&!pmRow(x.line)){x.line='';x.parent=null;x.form=null;}if(x.parent&&!LC.entity(active(),x.parent)){x.parent=null;x.form=null;}if(x.account&&!active().accounts.some(a=>a.id===x.account))x.account='';if(x.sub&&!active().accounts.some(a=>a.subAccounts.some(s=>s.id===x.sub)))x.sub='';if(x.vendorPage&&!pmVendor(x.vendorPage))x.vendorPage='';const f=x.form;if(f?.postId&&cf.ledger.some(e=>e.id===f.postId))x.form=null;if(f&&['doc','preview'].includes(f.kind)&&!(f.agreementVendorId?vdAgreementList(pmVendor(f.agreementVendorId)||{}).some(d=>d.id===f.value?.id):cf.documents.some(d=>d.id===f.value?.id)))x.form=null;if(f?.kind==='vendor'&&f.value?.id&&!pmVendor(f.value.id))x.form=null;return x;}
   async function spaceMove(delta){if(spaceNav.restoring||spaceNav.hold||pm.busy)return;const pos=spaceNav.pos+delta;if(pos<0||pos>=spaceNav.entries.length)return;spaceSave();spaceNav.restoring=true;try{const x=spaceSanitize(spaceClone(spaceNav.entries[pos]));if(pm.preview)URL.revokeObjectURL(pm.preview);pm.preview=null;for(const k of spaceFields)pm[k]=x[k];pm.form=x.form;pm.downloadError='';pm.notice='';if(pm.form?.kind==='preview'){const d=pm.form.agreementVendorId?vdAgreementList(pmVendor(pm.form.agreementVendorId)||{}).find(d=>d.id===pm.form.value.id):pmCF().documents.find(d=>d.id===pm.form.value.id);if(d)pm.preview=URL.createObjectURL(await pmBlob(d));else pm.form=null;}spaceNav.pos=pos;pmRender();const body=document.querySelector('#pm-layer .pm-body');if(body)body.scrollTop=x.scroll||0;}finally{spaceNav.restoring=false;spaceBar();}}
   const spaceOldRender=pmRenderBody;pmRenderBody=function(){if(!spaceNav.restoring)spaceSave();spaceOldRender();spaceTrack();spaceBar();};
