eduled yet')}</td><td>${pmAmount(PC.sum(pmParts(p),a=>a.base+a.fringe))}</td><td>${!p.cancelled&&PC.pending(active(),p,pmCalc)>.009?pmBtn('record','Record paid',p.id):''}${!p.cancelled?pmBtn('edit-schedule','Edit',p.id)+pmBtn('cancel-schedule','Cancel unpaid',p.id):''}</td></tr>`).join('')||'<tr><td colspan="4">No separate payment plans.</td></tr>'}</tbody></table></div></details>`;}
+  function lcPlanList(){const cf=LC.ensure(active()),plans=cf.schedules.filter(p=>!p.invoiceId&&!p.directPayment&&pmVisible(p));return`<details class="lc-section"><summary>Payment plans (${plans.length})</summary><p class="pm-note">Plans are expected payments, not invoices or posted costs. Link an invoice to an existing plan to avoid creating the same obligation twice.</p><div class="pm-scroll"><table class="pm-table"><thead><tr><th>Planned payment</th><th>Due</th><th>Remaining</th><th>Actions</th></tr></thead><tbody>${plans.map(p=>`<tr><td>${esc(p.label)}${p.cancelled?' · Cancelled':''}${!p.cancelled&&pmRecipientTbd(p)?'<br><strong>Recipient TBD</strong>':''}</td><td>${esc(PC.date(active(),p)||'Not scheduled yet')}</td><td>${pmAmount(PC.sum(pmParts(p),a=>a.base+a.fringe))}</td><td>${!p.cancelled&&PC.pending(active(),p,pmCalc)>.009?pmBtn('record','Record paid',p.id):''}${!p.cancelled?pmBtn('edit-schedule',pmRecipientTbd(p)?'Edit / assign recipient':'Edit',p.id)+pmBtn('cancel-schedule','Cancel unpaid',p.id):''}</td></tr>`).join('')||'<tr><td colspan="4">No separate payment plans.</td></tr>'}</tbody></table></div></details>`;}
   function lcHistory(){const cf=LC.ensure(active()),es=cf.ledger.filter(e=>e.allocations.some(a=>pmMatch(a.lineId))).sort((a,b)=>a.date.localeCompare(b.date));return`<h3>Payment &amp; correction history</h3><div class="pm-scroll"><table class="pm-table lc-table"><thead><tr><th>Date / record</th><th>Recipient / note</th><th>Net amount here</th><th>Evidence</th><th>Actions</th></tr></thead><tbody>${es.map(e=>`<tr><td>${esc(e.date)}<br>${esc(e.label)} · ${esc(e.kind)}</td><td>${esc(e.payeeId?lcParty(e.payeeId):'Legacy payment')}<br>${esc(e.note||'')}</td><td>${pmAmount(PC.sum(e.allocations.filter(a=>pmMatch(a.lineId)),a=>a.base+a.fringe))}</td><td>${e.kind==='payment'?(e.receiptIds||[]).some(id=>cf.documents.some(d=>d.id===id))?'Receipt attached':'Receipt missing':''}</td><td>${e.kind==='payment'?pmBtn('lc-evidence','Attach receipt…',e.id)+pmBtn('refund','Refund',e.id)+pmBtn('reverse','Correct / reverse',e.id):''}</td></tr>`).join('')||'<tr><td colspan="5">No posted payments.</td></tr>'}</tbody></table></div>`;}
   function lcReturns(){const rs=LC.ensure(active()).returns.filter(r=>pmMatch(r.lineId));return`<h3>Returns &amp; refundable deposits</h3><p class="pm-note">Expected refunds are forecast incoming cash, not money already received. Only Record refund changes paid Actuals.</p>${rs.map(r=>`<div class="lc-return"><div><b>${esc(r.label)}</b><br>${esc(pmLabel(r.lineId))}<br>${r.cancelled?'Cancelled':pmAmount(LC.outstandingReturn(active(),r))+' still expected'} · ${esc(r.expectedDate||'Date not set')}</div><div>${!r.cancelled&&LC.outstandingReturn(active(),r)>.009?pmBtn('lc-receive-return','Record refund…',r.id)+pmBtn('lc-cancel-return','Cancel expectation',r.id):''}</div></div>`).join('')||'<p class="pm-note">No expected refunds.</p>'}`;}
