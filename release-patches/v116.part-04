ng(),/Date,Direction,Account,Amount,Description,Status/);await p.locator('[data-pm="calendar-today"]').click();assert.equal(await range.inputValue(),'month');assert.equal(await p.locator('.pm-day-today').count(),1);await p.locator('[data-pm="tab"][data-id="vendors"]').click();await p.locator('.vd-vendor-card [data-pm="vendor-dashboard"]').first().click();assert(await p.locator('.vd-calendar-stream').count());assert(await p.locator('[data-pm="vendor-calendar-today"]').count());await p.locator('[data-pm="vendor-calendar-today"]').click();assert(await p.locator('.vd-day-today').count());assert.deepEqual(errors,[]);console.log('PASS range controls, CSV, Today, timeline and vendor calendar');}finally{await b.close()}})().catch(e=>{console.error(e);process.exitCode=1});
