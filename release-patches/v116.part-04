 const assert=require('node:assert/strict'),path=require('node:path'),{chromium}=require('playwright');
-(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{const p=await browser.newPage({viewport:{width:1440,height:900}}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.clock.install({time:new Date('2026-11-24T12:00:00Z')});await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="timeline"]').click();assert(await p.locator('.pt-row').count()>=3);assert(await p.locator('.pt-bar').count()>=1);assert(await p.locator('.pt-week-tick').count());assert.match(await p.locator('.pt-overview').innerText(),/Funding/);await p.locator('[data-pm="tab"][data-id="calendar"]').click();await p.locator('[name="mainFrom"]').fill('2025-01-01');await p.locator('[name="mainTo"]').fill('2028-12-31');const stream=p.locator('.pm-calendar-stream');for(let i=0;i<25;i++){await stream.evaluate(e=>e.scrollTop=e.scrollHeight);await p.waitForTimeout(20)}let months=await p.locator('.pm-month-panel').evaluateAll(es=>es.map(e=>e.dataset.month));assert(months.at(-1)>'2026-01','scrolls forward within range');assert(months.length<=18,'rendered months remain bounded');for(let i=0;i<30;i++){await stream.evaluate(e=>e.scrollTop=0);await p.waitForTimeout(20)}months=await p.locator('.pm-month-panel').evaluateAll(es=>es.map(e=>e.dataset.month));assert.equal(months[0],'2025-01','scrolls to inclusive range start');await p.locator('[data-pm="calendar-today"]').click();assert.equal(await p.locator('[name="mainRange"]').inputValue(),'month');assert.equal(await p.locator('.pm-tabs svg').count(),9);assert.deepEqual(errors,[]);console.log('PASS visual timeline, daily/weekly grid, bounded range scrolling and Today');}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
+(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{const p=await browser.newPage({viewport:{width:1440,height:900}}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.clock.install({time:new Date('2026-11-24T12:00:00Z')});await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="calendar"]').click();assert(await p.locator('.pt-row').count()>=3);assert(await p.locator('.pt-bar').count()>=1);assert(await p.locator('.pt-week-tick').count());assert.match(await p.locator('.pt-overview').innerText(),/Funding/);await p.locator('[data-pm="tab"][data-id="calendar"]').click();await p.locator('[name="mainFrom"]').fill('2025-01-01');await p.locator('[name="mainTo"]').fill('2028-12-31');const stream=p.locator('.pm-calendar-stream');for(let i=0;i<25;i++){await stream.evaluate(e=>e.scrollTop=e.scrollHeight);await p.waitForTimeout(20)}let months=await p.locator('.pm-month-panel').evaluateAll(es=>es.map(e=>e.dataset.month));assert(months.at(-1)>'2026-01','scrolls forward within range');assert(months.length<=18,'rendered months remain bounded');for(let i=0;i<30;i++){await stream.evaluate(e=>e.scrollTop=0);await p.waitForTimeout(20)}months=await p.locator('.pm-month-panel').evaluateAll(es=>es.map(e=>e.dataset.month));assert.equal(months[0],'2025-01','scrolls to inclusive range start');await p.locator('[data-pm="calendar-today"]').click();assert.equal(await p.locator('[name="mainRange"]').inputValue(),'month');assert.equal(await p.locator('.pm-tabs svg').count(),8);assert.deepEqual(errors,[]);console.log('PASS visual timeline, daily/weekly grid, bounded range scrolling and Today');}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
