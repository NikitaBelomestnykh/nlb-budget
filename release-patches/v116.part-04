diff --git a/tests/design-v116.test.cjs b/tests/design-v116.test.cjs
new file mode 100644
index 0000000..a689512
--- /dev/null
+++ b/tests/design-v116.test.cjs
@@ -0,0 +1,9 @@
+const assert=require('node:assert/strict'),path=require('node:path'),fs=require('node:fs'),os=require('node:os'),{execFileSync}=require('node:child_process'),{chromium}=require('playwright');
+(async()=>{const browser=await chromium.launch({...(process.env.CHROMIUM?{executablePath:process.env.CHROMIUM}:{}),headless:true,args:['--no-sandbox','--allow-file-access-from-files']}),tmp=fs.mkdtempSync(path.join(os.tmpdir(),'nlb-116-'));try{
+ const p=await browser.newPage({viewport:{width:1440,height:900},acceptDownloads:true}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.clock.install({time:new Date('2026-11-24T12:00:00Z')});await p.goto('file://'+path.resolve(__dirname,'../index.html'));await p.locator('[data-action="pm-open"]').click();await p.locator('[data-pm="tab"][data-id="calendar"]').click();
+ assert.equal(await p.locator('[data-pm="tab"][data-id="timeline"]').count(),0);assert.equal(await p.locator('[name="mainRange"]').inputValue(),'max');assert(await p.locator('.pt-overview').count());assert(await p.locator('.pm-calendar-section').count());assert(await p.locator('.pt-scroll').evaluate(e=>e.scrollWidth>e.clientWidth),'timeline has a scrollable axis');
+ await p.locator('[name="mainRange"]').selectOption('month');let stream=p.locator('.pm-calendar-stream');assert(await stream.evaluate(e=>e.classList.contains('pm-single-month')&&e.scrollHeight<=e.clientHeight+2),'single month has no internal vertical clipping');let positions=await p.locator('.pm-calendar-controls').evaluate(e=>[...e.querySelectorAll('.pm-field input,.pm-field select,button,.pm-checkbox')].map(x=>{let r=x.getBoundingClientRect();return [r.top,r.bottom]}));assert(positions.every(x=>Math.abs((x[0]+x[1])-(positions[0][0]+positions[0][1]))<4),'controls vertically centered');
+ await p.locator('[name="mainFrom"]').fill('2026-11-03');await p.locator('[name="mainTo"]').fill('2026-11-10');const [dl]=await Promise.all([p.waitForEvent('download'),p.locator('[data-pm="calendar-pdf"]').click()]);const pdf=path.join(tmp,'calendar.pdf');await dl.saveAs(pdf);try{const text=execFileSync('pdftotext',['-layout',pdf,'-']).toString();assert.match(text,/DUE\s+\$18,900\.00/);assert.match(text,/Transaction list/);assert.match(text,/DATE: 2026-11-03/);assert.match(text,/DATE: 2026-11-07/);assert.match(text,/DATE: 2026-11-10/);assert(!text.includes('DATE: 2026-11-04'));}catch(e){if(e.code!=='ENOENT')throw e;}
+ await p.locator('.pm-day').filter({hasText:'Due $18,900.00'}).locator('[data-pm="calendar-day-more"]').click();assert.equal(await p.locator('.pm-day-detail').count(),1);await p.locator('[data-pm="cancel-editor"]').first().click();
+ await p.locator('[data-pm="tab"][data-id="crew"]').click();const controls=await p.locator('.vd-vendors-intro>div:last-child button').evaluateAll(bs=>bs.map(b=>({box:b.getBoundingClientRect().toJSON(),plus:getComputedStyle(b,'::before').content})));assert(controls[1].box.left-controls[0].box.right>=8);assert(controls[1].plus.includes('+'));await p.locator('[data-pm="new-vendor"]').click();assert.equal(await p.locator('.contact-profile .contact-group').count(),4);await p.locator('[name="name"]').fill('Design Test Person');await p.locator('[name="allergies"]').fill('Peanuts');await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();await p.locator('[data-pm="vendor-link"]').click();assert(await p.locator('.vd-link-account').count());assert(await p.locator('.vd-link-sub').count());const chosen=p.locator('[name="vendorLine"]').first(),id=await chosen.inputValue();await chosen.check();await p.locator('[name="vendorLineSearch"]').fill('not-a-real-account-or-line');assert.equal(await p.locator('.vd-link-option:visible').count(),0);assert(await chosen.isChecked(),'filter retains selections');await p.locator('form[data-pm-form="editor"] button[type="submit"]').click();assert(await p.locator(`.vd-line [data-id="${id}"]`).count()||await p.locator('.vd-line').count()===1,'hidden selected line linked');assert.deepEqual(errors,[]);console.log('PASS merged calendar, timeline readability, PDF list, profile and searchable line linking');
+ }finally{await browser.close();fs.rmSync(tmp,{recursive:true,force:true})}})().catch(e=>{console.error(e);process.exitCode=1});
diff --git a/tests/timeline-calendar.test.cjs b/tests/timeline-calendar.test.cjs
index 1c810c0..d30f1dd 100644
