new file mode 100644
index 0000000..551f05f
--- /dev/null
+++ b/tests/design-polish-v1201.test.cjs
@@ -0,0 +1,10 @@
+const assert=require('node:assert/strict'),path=require('node:path'),{chromium}=require('playwright');
+(async()=>{const browser=await chromium.launch({executablePath:process.env.CHROMIUM||undefined,headless:true,args:['--no-sandbox','--allow-file-access-from-files']});try{
+for(const scheme of ['light','dark']){const p=await browser.newPage({viewport:{width:1440,height:900},colorScheme:scheme}),errors=[];p.on('pageerror',e=>errors.push(e.message));await p.goto('file://'+path.resolve(__dirname,'../index.html'));
+await p.evaluate(()=>{const k='no-longer-budget-v9',s=JSON.parse(localStorage.getItem(k)),b=s.budgets[0],a=b.accounts[0],sub=a.subAccounts[0],l=sub.lines[0];Object.assign(l,{id:'target',description:'Test line',qty:1,x:1,rate:1000,fringeIds:[],groupIds:[],raw:{},actual:'',vendorId:undefined});sub.lines=[l];a.subAccounts=[sub];b.accounts=[a];b.fringes=[];b.cashflow={version:1,lineMeta:{},schedules:[],ledger:[],funding:[],documents:[],phases:{prepStart:'2026-11-24',prepEnd:'2026-12-03',prodStart:'2026-12-04',prodEnd:'2026-12-06'},milestones:[{id:'milestone',name:'Delivery',date:'2026-12-07'}],openingCash:0,openingDate:'',invoices:[],returns:[]};s.budgets=[b];s.activeBudgetId=b.id;s.vendors=[];localStorage.setItem(k,JSON.stringify(s));});await p.reload();await p.locator('[data-action="pm-open"]').click();
+const wrap=p.locator('.lc-page').first().boundingBox(),close=p.locator('.clarity-closeout').boundingBox();let [w,c]=await Promise.all([wrap,close]);assert(Math.abs(w.x-c.x)<1&&Math.abs(w.width-c.width)<1,'closeout aligns to payment page');
+await p.locator('[data-pm="line"][data-id="target"]').first().click();assert.match(await p.locator('.journey-progress').innerText(),/Assigned/);assert(!/\bContact\b/.test(await p.locator('.journey-progress').innerText()));const btn=p.locator('[data-pm="details-create-contact"]'),sel=p.locator('form[data-pm-form="lc-setup"] [name="vendorId"]');let [bb,sb]=await Promise.all([btn.boundingBox(),sel.boundingBox()]);assert(Math.abs(bb.y+bb.height/2-sb.y-sb.height/2)<1,'plus centered alongside select');assert.equal(await btn.evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(244, 182, 63)');assert.equal(await p.locator('.space-return').count(),1);await p.locator('.space-return').click();
+await p.locator('[data-pm="tab"][data-id="calendar"]').click();let phase=p.locator('.pt-row').filter({hasText:'Pre-production'});assert(!/2026-11-24/.test(await phase.locator('.pt-label').innerText()));const bar=phase.locator('.pt-date-marker');assert.match(await bar.getAttribute('aria-label'),/2026-11-24.*2026-12-03/);await bar.hover();assert(await bar.locator('.pt-date-tip').isVisible());await bar.focus();assert(await bar.locator('.pt-date-tip').isVisible());assert(!/2026-12-07/.test(await p.locator('.pt-row').filter({hasText:'Delivery'}).locator('.pt-label').innerText()));
+const check=p.locator('.pm-calendar-controls input[type="checkbox"]');assert.equal(await check.evaluate(e=>getComputedStyle(e).appearance),'none');await check.check();assert.equal(await check.evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(244, 182, 63)');await check.uncheck();assert.notEqual(await check.evaluate(e=>getComputedStyle(e).backgroundColor),'rgb(244, 182, 63)');assert.deepEqual(errors,[]);await p.close();}
+console.log('PASS aligned add/back controls, closeout width, accessible timeline dates and themed checks');
+}finally{await browser.close()}})().catch(e=>{console.error(e);process.exitCode=1});
