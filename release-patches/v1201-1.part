}</div></div><div class="pm-fixed-fields"><h4>Allocate the fixed amount</h4><p class="pm-note">Enter the payment total and split it across the relevant lines. Split an all-in amount into base and fringe only once; leave other lines at zero.</p>${pmInput('total','Whole fixed payment total',p.total!=null?p.total:(ex.base+ex.fringe),'number','min="0" step="0.01"')}<div class="pm-scroll"><table class="pm-table pm-allocation-table"><thead><tr><th>Line / vendor</th><th>Base amount</th><th>Fringe amount</th></tr></thead><tbody>${pmGroupRows(pmRows(),3,r=>{const a=(p.allocations||[]).find(a=>a.lineId===r.line.id)||{base:r.line.id===id?ex.base:0,fringe:r.line.id===id?ex.fringe:0};return`<tr><td>${esc(pmLabel(r.line.id))}<br>${esc(pmVendorLabel(r.line.vendorId))}</td><td><input type="text" inputmode="decimal" data-pm-numeric="true" name="base:${esc(r.line.id)}" aria-label="Base allocation ${esc(r.line.description)}" min="0" step="0.01" value="${PC.money(a.base)}"></td><td><input type="text" inputmode="decimal" data-pm-numeric="true" name="fringe:${esc(r.line.id)}" aria-label="Fringe allocation ${esc(r.line.description)}" min="0" step="0.01" value="${PC.money(a.fringe)}"></td></tr>`;})}</tbody></table></div></div></section><section class="schedule-section"><div class="schedule-section-heading"><span aria-hidden="true">03</span><div><h4>Due date</h4><p>Set a date or link it to a production milestone.</p></div></div><div class="pm-grid">${pmSelect('dateMode','Date type',[{id:'fixed',name:'Fixed date'},{id:'relative',name:'Milestone-relative'}],p.dateMode||'fixed')}<div class="schedule-fixed-date">${pmInput('due','Due date',p.due||'','date')}</div><div class="schedule-relative">${pmSelect('milestone','Milestone',pmMilestones(),p.milestone||'prodStart')}</div><div class="schedule-relative">${pmInput('offset','Days before (-) / after (+)',p.offset||0,'number','step="1"')}</div></div></section><section class="schedule-section"><div class="schedule-section-heading"><span aria-hidden="true">04</span><div><h4>Notes</h4><p>Optional details for this payment.</p></div></div>${pmInput('note','Notes',p.note||'')}</section></div>`;}
+ else if(kind==='schedule'){title=p.id?'Edit unpaid installment':'New installment / split payment';const id=p.lineId||pm.line||'',ex=id?PC.expected(active(),id,pmCalc):{base:0,fringe:0};const vendorDefault=p.paymentVendorId!==undefined?p.paymentVendorId:(p.recipientTbd?'':(p.payeeId||p.vendorId||(id?lcPayee(id):'')||((p.allocations||[])[0]?.lineId?lcPayee(p.allocations[0].lineId):'')||''));fields=`<div class="schedule-layout"><section class="schedule-section"><div class="schedule-section-heading"><span aria-hidden="true">01</span><div><h4>Payment details</h4><p>Who is this payment for?</p></div></div><div class="pm-grid">${pmInput('label','Payment label',p.label||'','text','required')}<div class="pm-vendor-picker">${pmSelect('paymentVendorId','Payment recipient / Paid through',pmVendors().filter(v=>!v.archived||v.id===vendorDefault),vendorDefault,'Recipient TBD')}${pmBtn('schedule-create-vendor','Create vendor & use here…','','pm-primary')}</div></div><p class="pm-note">A recipient is optional for planning. If selected, it is assigned to unassigned lines; existing assignments and explicitly unlinked lines are not changed. Assign a recipient before recording the payment.</p></section><section class="schedule-section"><div class="schedule-section-heading"><span aria-hidden="true">02</span><div><h4>Amount</h4><p>Choose how the payment is calculated.</p></div></div><div class="pm-grid">${pmSelect('mode','Amount type',[{id:'fixed',name:'Fixed amount / split'},{id:'percent',name:'Percentage'},{id:'remaining',name:'Remaining balance'}],p.mode||'fixed')}<div class="schedule-calculated">${pmLineSelect('lineId','Budget line',id,'Choose line')}</div><div class="schedule-calculated">${pmSelect('component','Cost component',[{id:'both',name:'Base + fringes together'},{id:'base',name:'Base only (fringes separate)'},{id:'fringe',name:'Fringes only'}],p.component||'both')}</div><div class="schedule-percent">${pmInput('percent','Percentage',p.percent||50,'number','min="0.01" max="100" step="0.01"')}</div></div><div class="pm-fixed-fields"><h4>Allocate the fixed amount</h4><p class="pm-note">Enter the payment total and split it across the relevant lines. Split an all-in amount into base and fringe only once; leave other lines at zero.</p>${pmInput('total','Whole fixed payment total',p.total!=null?p.total:(ex.base+ex.fringe),'number','min="0" step="0.01"')}<div class="pm-scroll"><table class="pm-table pm-allocation-table"><thead><tr><th>Line / vendor</th><th>Base amount</th><th>Fringe amount</th></tr></thead><tbody>${pmGroupRows(pmRows(),3,r=>{const a=(p.allocations||[]).find(a=>a.lineId===r.line.id)||{base:r.line.id===id?ex.base:0,fringe:r.line.id===id?ex.fringe:0};return`<tr><td>${esc(pmLabel(r.line.id))}<br>${esc(pmVendorLabel(r.line.vendorId))}</td><td><input type="text" inputmode="decimal" data-pm-numeric="true" name="base:${esc(r.line.id)}" aria-label="Base allocation ${esc(r.line.description)}" min="0" step="0.01" value="${PC.money(a.base)}"></td><td><input type="text" inputmode="decimal" data-pm-numeric="true" name="fringe:${esc(r.line.id)}" aria-label="Fringe allocation ${esc(r.line.description)}" min="0" step="0.01" value="${PC.money(a.fringe)}"></td></tr>`;})}</tbody></table></div></div></section><section class="schedule-section"><div class="schedule-section-heading"><span aria-hidden="true">03</span><div><h4