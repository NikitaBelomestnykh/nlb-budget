   function lcInvoiceList(){const b=active(),cf=LC.ensure(b),items=cf.invoices.filter(i=>i.allocations.some(a=>pmMatch(a.lineId)));return`<h3>Invoices</h3><p class="pm-note">One invoice, allocated once. An attachment supports the record; it never posts money by itself.</p><div class="pm-scroll"><table class="pm-table lc-table"><thead><tr><th>Invoice / recipient</th><th>Due</th><th>In this selection</th><th>Status</th><th>Actions</th></tr></thead><tbody>${items.map(i=>{const p=cf.schedules.find(p=>p.id===i.scheduleId),share=PC.sum(i.allocations.filter(a=>pmMatch(a.lineId)),a=>a.base+a.fringe),left=p?PC.sum(pmParts(p),a=>a.base+a.fringe):0;return`<tr><td><b>${esc(i.number)}</b> · ${esc(i.category)}<br>${esc(lcParty(i.payeeId))}<br><small>${esc(i.note||'')}${i.fringeBreakdown&&Object.values(i.fringeBreakdown).some(Number)?' · Fringe detail: '+esc(Object.entries(i.fringeBreakdown).filter(([k,n])=>n).map(([k,n])=>k+' '+pmAmount(n)).join(', ')):''}</small></td><td>${esc(p?PC.date(b,p)||'Not scheduled yet':i.due||'Not scheduled yet')}</td><td>${pmAmount(share)}<br><small>Still unpaid: ${pmAmount(left)}${share!==i.total?' · Whole invoice: '+pmAmount(i.total):''}</small></td><td>${LC.invoiceStatus(b,i,pmCalc)}</td><td>${p&&!p.cancelled&&PC.pending(b,p,pmCalc)>.009?pmBtn('record','Record payment…',p.id,'pm-primary'):''}${pmBtn('lc-invoice-docs','Documents',i.id)}${p&&!p.cancelled&&!cf.ledger.some(e=>e.scheduleId===p.id)?pmBtn('lc-cancel-invoice','Cancel invoice',i.id):''}</td></tr>`;}).join('')||'<tr><td colspan="5">No invoices yet. Add invoice… to record an obligation, or record a payment without an invoice. Uploading a file alone does not create an invoice.</td></tr>'}</tbody></table></div>`;}
