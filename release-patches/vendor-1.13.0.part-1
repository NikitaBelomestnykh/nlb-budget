   function pmMatch(id){const r=pmRow(id);if(!r)return false;return(!pm.account||r.account.id===pm.account)&&(!pm.sub||r.sub.id===pm.sub)&&(!pm.vendor||r.line.vendorId===pm.vendor)&&(!pm.line||id===pm.line);}
