diff --git a/assets/payments.css b/assets/payments.css
index 65e4bf5..cdba9d1 100644
--- a/assets/payments.css
+++ b/assets/payments.css
@@ -73,3 +73,13 @@ input[type="date"],input[type="month"]{color-scheme:light}input[type="date"]::-w
 .support-placeholder .support-status{color:var(--text-2);font-size:14px;font-weight:600;}
 .support-placeholder button{min-height:44px;color:var(--text-2);cursor:not-allowed;opacity:.7;}
 @media(max-width:700px){.space-nav{padding:12px;gap:8px;flex-wrap:wrap;}.space-crumbs{flex-basis:100%;}.space-arrows button{width:44px;height:44px;}}
+
+/* Daily planned outflow; history and funding are not part of the due total. */
+.pm-day-total{font-weight:700;color:var(--text);margin:6px 0;padding:4px 6px;border-left:3px solid var(--accent);background:var(--row-alt);overflow-wrap:anywhere}
+
+/* Work-in-progress vendor summary uses the existing payment ledger. */
+.vendor-dash-heading{display:flex;justify-content:space-between;align-items:start;gap:16px;margin-bottom:20px}.vendor-dash-heading h3{font-size:24px;margin:16px 0 4px}.vendor-dash-heading p{color:var(--muted);margin:0}.vendor-dash-line{display:grid;grid-template-columns:minmax(200px,2fr) 1fr 1fr auto;gap:16px;align-items:center;border:1px solid var(--border);border-radius:8px;padding:16px;margin:8px 0}.vendor-dash-line small,.vendor-dash-line strong{display:block}.vendor-dash-line small{margin:3px 0;color:var(--muted)}.vendor-dash-actions{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:700px){.vendor-dash-line{grid-template-columns:1fr 1fr}.vendor-dash-line>div:first-child,.vendor-dash-actions{grid-column:1/-1}}
+/* Vendor-first workspace: clear hierarchy, neutral surfaces and an amber due indicator. */
+.vd-vendors-intro,.vendor-dash-heading,.vd-section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.vd-vendors-intro h3,.vendor-dash-heading h3{font-size:24px;margin:8px 0}.vd-vendors-intro p,.vendor-dash-heading p,.vd-section-head p{color:var(--text-2);margin:4px 0 0}.vd-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}.vd-vendor-card,.vd-line,.vd-agreements article{border:1px solid var(--border);border-radius:8px;background:var(--canvas);padding:16px}.vd-card-head{display:flex;justify-content:space-between;gap:10px;align-items:center}.vd-card-head strong{font-size:16px}.vd-vendor-card p{min-height:1.5em;color:var(--text-2);overflow-wrap:anywhere}.vd-vendor-card small,.vd-line small,.vd-agreements small{display:block;color:var(--text-2);margin-top:4px}.vd-card-actions,.vd-line-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-top:16px}.vd-card-actions button,.vd-line-actions button,.vd-agreements button{min-height:36px}.vd-archive{grid-column:1/-1;margin:20px 0 0}.vendor-dash-heading{margin-bottom:24px}.vd-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.vd-stats>div{padding:16px;border:1px solid var(--border);border-radius:8px;background:var(--row-alt)}.vd-stats small{display:block;color:var(--text-2)}.vd-stats strong{display:block;font-size:20px;margin-top:8px;overflow-wrap:anywhere}.vd-section{padding-top:28px;margin-top:24px;border-top:1px solid var(--border)}.vd-section-head{align-items:center;margin-bottom:16px}.vd-section-head h3{margin:0}.vd-agreements{display:grid;gap:8px}.vd-agreements article{display:flex;justify-content:space-between;gap:12px;align-items:center}.vd-agreements article>div:last-child{display:flex;gap:6px;flex-wrap:wrap}.vd-agreements strong{overflow-wrap:anywhere}.vd-line{margin:10px 0}.vd-line-heading{display:flex;justify-content:space-between;gap:20px}.vd-line-heading strong{font-size:16px}.vd-line-amount{text-align:right;font-weight:700;white-space:nowrap}.vd-line-amount small{font-weight:400}.vd-line-plans{border-top:1px solid var(--border);margin-top:14px;padding-top:4px}.vd-line-plans p{color:var(--text-2)}.vd-plan{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--border)}.vd-line-actions span{color:var(--text-2);margin-left:auto}.vd-link-list{display:grid;gap:8px;margin:16px 0}.vd-link-option{display:flex;gap:12px;align-items:flex-start;padding:12px;border:1px solid var(--border);border-radius:8px}.vd-link-option input{width:18px;min-height:18px;margin-top:3px}.vd-link-option small{display:block;color:var(--text-2);margin-top:4px}.vd-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:1px solid var(--border);border-left:1px solid var(--border)}.vd-weekday,.vd-day{border-right:1px solid var(--border);border-bottom:1px solid var(--border);padding:8px;min-width:0}.vd-weekday{background:var(--row-alt);font-weight:700}.vd-day{min-height:105px}.vd-empty{background:var(--row-alt)}.vd-due{border-left:3px solid var(--accent);padding-left:6px;margin:8px 0;font-weight:700;overflow-wrap:anywhere}.vd-calendar-item{display:block;width:100%;text-align:left;background:var(--accent-soft);border:0;border-radius:4px;padding:6px;margin-top:5px;font:inherit;font-size:12px;overflow-wrap:anywhere;color:var(--text);cursor:pointer}.vd-calendar-item:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(max-width:900px){.vd-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.vd-calendar{min-width:700px}.vd-section:has(.vd-calendar){overflow-x:auto}}@media(max-width:600px){.vd-vendors-intro,.vd-section-head,.vendor-dash-heading,.vd-agreements article{flex-direction:column;align-items:stretch}.vd-line-heading{flex-direction:column;gap:8px}.vd-line-amount{text-align:left}.vd-line-actions span{margin-left:0}.vd-plan{flex-wrap:wrap}.vd-stats strong{font-size:17px}}
+.vd-more-filters{margin:12px 0}.vd-more-filters summary{cursor:pointer;color:var(--text-2)}.vd-more-filters .pm-grid{margin-top:12px}.vd-plan>div{display:flex;gap:6px;flex-wrap:wrap}.vd-plan>div button{min-height:32px}
+.vd-section-head>div:last-child{flex-shrink:0}.vd-calendar-item{white-space:normal}.vd-due{font-size:13px}@media(max-width:900px){.vd-calendar{min-width:980px}}
