@@ -97,3 +97,9 @@ input[type="date"],input[type="month"]{color-scheme:light}input[type="date"]::-w
 #pm-layer .pm-contact-roles { border:1px solid var(--pm-border, #555); border-radius:8px; padding:12px; margin:0 0 16px; }
 #pm-layer .pm-contact-roles label { display:inline-flex; align-items:center; gap:6px; margin-right:20px; }
 #pm-layer .pm-contact-roles input { width:16px; min-height:16px; }
+.vd-logo-editor{display:flex;align-items:center;gap:12px;margin:0 0 16px}.vd-logo-edit{width:64px;height:64px;padding:0;border:1px solid var(--border,#555);border-radius:50%;display:grid;place-items:center;background:transparent;overflow:hidden;cursor:pointer}.vd-logo-edit .vd-logo{width:100%;height:100%}.vd-logo-plus{font-size:32px;line-height:1}
+.pt-axis{display:block;position:relative;margin:0 59px 2px 190px;height:27px}.pt-axis-inner{position:relative;height:100%}.pt-tick{position:absolute;top:8px;font-size:10px;white-space:nowrap}.pt-week-tick{font-weight:700;top:0}.pt-track{background-image:linear-gradient(to right,var(--border) 1px,transparent 1px)}.pt-funding-received{background:#52b76e}.pt-overview .pm-card-heading>div:last-child{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
+.pm-calendar-stream .pm-calendar{grid-auto-rows:116px;grid-template-rows:30px}.pm-calendar-stream .pm-day{min-height:0;height:116px;box-sizing:border-box;overflow:hidden}.pm-calendar-stream .pm-day-today,.vd-day-today{box-shadow:inset 0 0 0 3px #f5b62f}.pm-day-outside{opacity:.45}.pm-event.pm-event-upcoming{background:var(--row-alt)}.pm-event.pm-event-late{background:#a5742344}.pm-event.pm-event-paid{background:#40a85c3d}.pm-calendar-stream .pm-event{max-height:55px;overflow:hidden;line-height:1.25}.pm-calendar-stream .pm-day button{padding:2px 4px;min-height:22px;font-size:10px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+.vd-calendar-stream{height:min(62vh,640px);min-height:320px;overflow:auto;overscroll-behavior:contain;border:1px solid var(--border);border-radius:8px;padding:0 12px}.vd-month-panel{min-width:700px;padding:12px 0 18px}.vd-month-panel h4{margin:0 0 10px}.vd-calendar{grid-auto-rows:116px;grid-template-rows:36px}.vd-day{height:116px;min-height:0;box-sizing:border-box;overflow:hidden}.vd-day .pm-event{display:block;max-height:50px;overflow:hidden;font-size:11px;padding:4px}.vd-day button{min-height:22px;padding:2px 4px;font-size:10px}.vd-day .vd-due{font-size:11px;margin:3px 0}
+.pm-calendar-stream .pm-calendar{grid-auto-rows:150px}.pm-calendar-stream .pm-day{height:150px}.vd-calendar{grid-auto-rows:150px}.vd-day{height:150px}.pm-calendar-controls .pm-field{flex:0 1 150px}.pm-calendar-controls .pm-field input,.pm-calendar-controls .pm-field select{width:100%}@media(max-width:700px){.pt-overview .pm-card-heading{align-items:flex-start;flex-direction:column;gap:12px}.pm-calendar-controls .pm-field{flex:1 1 130px}}
+.pt-row .pt-label{position:sticky;left:0;z-index:2;background:var(--canvas)}.pt-row>button{position:sticky;right:0;z-index:2}
