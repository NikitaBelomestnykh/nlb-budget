   function pmStats(){const b=active(),cf=pmCF(),ex=pmRows().reduce((v,r)=>{const h=PC.hot(b,r.line.id,pmCalc);return v+h.base+h.fringe;},0),paid=PC.sum(cf.ledger,e=>e.amount)+PC.sum(Object.values(cf.lineMeta),m=>(m.openingBase||0)+(m.openingFringe||0)),uns=PC.sum(PC.unscheduled(b,pmCalc),r=>r.base+r.fringe),reserve=PC.reserve(b,pmCalc);const warnings=pmRows().filter(r=>{const ex=PC.expected(b,r.line.id,pmCalc);return ['base','fringe'].some(c=>PC.net(b,r.line.id,c)>ex[c]+.009||PC.net(b,r.line.id,c)+PC.scheduled(b,r.line.id,pmCalc,c)>ex[c]+.009);});return`<div class="pm-stats">${[['Expected final cost',ex],['Net paid',paid],['Not scheduled yet',uns],['Contingency reserve remaining',reserve.remaining]].map(([l,v])=>`<div class="pm-stat"><small>${l}</small><strong>${pmAmount(v)}</strong></div>`).join('')}</div>${warnings.length?'<div class="pm-alert">Overpaid or overallocated against approved expected costs: '+warnings.map(r=>esc(pmLabel(r.line.id))).join('; ')+'. Review installments and approved invoice costs. The forecast retains the higher commitment.</div>':''}${reserve.exceeded?'<div class="pm-alert">Reserve allocations exceed contingency. Review the allocated amounts before relying on the cash forecast.</div>':''}`;}
   function pmFilters(){const b=active(),a=b.accounts.find(a=>a.id===pm.account);return`<div class="pm-filter-scroll"><div class="pm-toolbar pm-inline-filters">${pmSelect('filterAccount','Account',b.accounts.map(a=>({id:a.id,name:a.num+' '+a.name})),pm.account,'All accounts')}${pmSubSelect('filterSub','Sub-account',a?[a]:b.accounts,pm.sub,'All sub-accounts')}${pmSelect('filterVendor','Vendor',pmVendors().filter(v=>!v.archived||v.id===pm.vendor),pm.vendor,'All vendors')}${pm.line?`<span class="pm-badge">${esc(pmLabel(pm.line))}</span>${pmBtn('clear-line','Show all lines')}`:''}</div></div>`;}
   function pmRender(){return PC.batch(active(),pmCalc,()=>pmRenderBody());}
