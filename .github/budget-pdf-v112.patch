   function clarityValidateWorkspace(payload){if(payload.workspaceBackupFormat!=='nlb-workspace-1'||!Array.isArray(payload.budgets)||!Array.isArray(payload.vendors)||!Array.isArray(payload.folders))throw Error('Invalid workspace backup.');const unique=(xs,label)=>{if(xs.some(x=>!x||typeof x.id!=='string'||!x.id)||new Set(xs.map(x=>x.id)).size!==xs.length)throw Error('Invalid or duplicate '+label+'.');};unique(payload.budgets,'budget identifiers');unique(payload.vendors,'vendor identifiers');unique(payload.folders,'folder identifiers');if(payload.vendors.some(v=>typeof v.name!=='string'||!v.name.trim())||payload.folders.some(f=>typeof f.name!=='string'||!f.name.trim()))throw Error('Invalid contact or folder names.');if(payload.activeBudgetId&&!payload.budgets.some(b=>b.id===payload.activeBudgetId))throw Error('Active budget is missing.');const originals=[];for(const b of payload.budgets){if(!Array.isArray(b.accounts)||typeof b.title!=='string'||b.folderId&&!payload.folders.some(f=>f.id===b.folderId))throw Error('Invalid budget or folder reference.');b.vendorRefs=payload.vendors;pmValidateBackup(b);if(!Array.isArray(b.attachmentData))throw Error('Original document list is missing.');const docs=b.cashflow?.documents||[];if(new Set(b.attachmentData.map(a=>a.documentId)).size!==b.attachmentData.length||b.attachmentData.length!==docs.length)throw Error('Original document list does not match this budget.');for(const d of docs){const a=b.attachmentData.find(a=>a.documentId===d.id);if(!a?.base64)throw Error('Missing original: '+d.originalName);const blob=pmDecode(a.base64,d.type);if(d.size!=null&&d.size!==blob.size)throw Error('Document bytes do not match '+d.originalName);originals.push({doc:d,blob});}}return originals;}
   async function clarityImportWorkspace(payload,originals){if(pm.busy)return;pm.busy=true;const before=JSON.stringify(state),stored=[];let mutated=false;try{for(const {doc,blob} of originals){doc.key=pmId();await pmStore('put',doc.key,blob);stored.push(doc.key);}if(before!==JSON.stringify(state))throw Error('The workspace changed during import. Try again.');snapshotState();mutated=true;const mapping=Object.create(null);for(const v of payload.vendors){let match=pmVendors().find(x=>clarityContactKey(x)===clarityContactKey(v));if(!match){match={...v,id:pmId()};pmVendors().push(match);}mapping[v.id]=match.id;}const folderMap=Object.create(null);state.folders=state.folders||[];for(const f of payload.folders){const newFolder={...f,id:pmId(),name:f.name+' (Imported)'};folderMap[f.id]=newFolder.id;state.folders.push(newFolder);}let selected='';for(const b of payload.budgets){const oldId=b.id;LC.remapVendors(b,mapping);delete b.attachmentData;delete b.vendorRefs;b.id=pmId();b.title+=' (Imported)';b.folderId=b.folderId?folderMap[b.folderId]:null;state.budgets.push(b);if(oldId===payload.activeBudgetId)selected=b.id;}if(selected)state.activeBudgetId=selected;state=migrate(state);view={mode:'sheet'};pmSync();save();render();closeImportPanel();window.alert('Workspace imported: '+payload.budgets.length+' budgets and '+payload.vendors.length+' contact records reviewed. Existing budgets and contacts were not replaced.');}catch(e){if(mutated)state=JSON.parse(before);for(const key of stored)await pmStore('delete',key);render();window.alert('Workspace import stopped: '+e.message);}finally{pm.busy=false;}}
